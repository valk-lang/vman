use vman
use valk.json

@ignore_access

fn outdated_req_lookup(v: vman.Version) vman.ValkRequire {
    if v.name == "2.0.0" {
        let conf: json.Value = json.decode("{\"require\":{\"valk\":{\"min\":\"0.9.0\"}}}") !? json.new_object()
        return vman.ValkRequire.from_config(conf)
    }
    return vman.ValkRequire {}
}

test "Outdated: skips requirement lookup when already at newest version" {
    let calls = Array[String]{}
    let versions = Array[vman.Version]{ must_version("0.1.0"), must_version("0.2.0") }
    let res = vman.evaluate_outdated("cli", "github.com/zikue/valk-cli", "0.2.0", "0.2.x", versions, must_version("0.8.10"), fn(v: vman.Version) vman.ValkRequire {
        calls.append(v.name)
        return vman.ValkRequire {}
    })
    assert(calls.length == 0)
    assert(!res.is_outdated())
    assert(res.current == "0.2.0" && res.wanted == "0.2.0" && res.latest == "0.2.0")
}

test "Outdated: distinguishes in-mask wanted updates and out-of-mask latest updates" {
    let versions = Array[vman.Version]{ must_version("0.2.0"), must_version("0.2.3"), must_version("0.3.1") }

    // Both in-mask (0.2.3) and out-of-mask (0.3.1) updates available
    let both = vman.evaluate_outdated("cli", "github.com/zikue/valk-cli", "0.2.0", "0.2.x", versions, must_version("0.8.10"), outdated_req_lookup)
    assert(both.is_outdated())
    assert(both.has_wanted_update && both.wanted == "0.2.3")
    assert(both.has_latest_update && both.latest == "0.3.1")
    assert(!both.needs_newer_valk)

    // Only out-of-mask update (0.3.1) available
    let outer = vman.evaluate_outdated("cli", "github.com/zikue/valk-cli", "0.2.3", "0.2.x", versions, must_version("0.8.10"), outdated_req_lookup)
    assert(outer.is_outdated())
    assert(!outer.has_wanted_update && outer.wanted == "0.2.3")
    assert(outer.has_latest_update && outer.latest == "0.3.1")

    // Only in-mask update available
    let inner_versions = Array[vman.Version]{ must_version("0.2.0"), must_version("0.2.3") }
    let inner = vman.evaluate_outdated("cli", "github.com/zikue/valk-cli", "0.2.0", "0.2.x", inner_versions, must_version("0.8.10"), outdated_req_lookup)
    assert(inner.is_outdated())
    assert(inner.has_wanted_update && inner.wanted == "0.2.3")
    assert(!inner.has_latest_update && inner.latest == "0.2.3")
}

test "Outdated: reports newer versions that require a newer valk" {
    let versions = Array[vman.Version]{ must_version("1.0.0"), must_version("1.1.0"), must_version("2.0.0") }

    let res = vman.evaluate_outdated("pkg", "github.com/user/pkg", "1.1.0", "1.x", versions, must_version("0.8.10"), outdated_req_lookup)
    assert(res.is_outdated())
    assert(!res.has_wanted_update)
    assert(!res.has_latest_update)
    assert(res.needs_newer_valk)
    assert(res.newest == "2.0.0")
    assert(res.newest_require == ">= 0.9.0")

    let j = res.to_json()
    assert(j.get("package").string == "pkg")
    assert(j.get("current").string == "1.1.0")
    assert(j.get("newest").string == "2.0.0")
    assert(j.get("newest_requires_valk").string == ">= 0.9.0")
}

test "Outdated: handles unpinned dependencies" {
    let versions = Array[vman.Version]{ must_version("1.0.0"), must_version("1.2.0") }
    let res = vman.evaluate_outdated("pkg", "github.com/user/pkg", "", "1.x", versions, must_version("0.8.10"), outdated_req_lookup)
    assert(res.is_outdated())
    assert(res.current == "-")
    assert(res.has_wanted_update && res.wanted == "1.2.0")
}
