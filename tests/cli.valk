
use vman

@ignore_access

test "CLI: extracts options without disturbing arguments" {
    let args = Array[String] { "vman", "install", "-h", "pkg", "--force" }
    let options = vman.extract_options(args)
    assert(options == Array[String] { "-h", "--force" })
    assert(args == Array[String] { "vman", "install", "pkg" })
}

test "CLI: quotes shell arguments" {
    #if OS == "win"
    assert(vman.shell_quote("repo path") == "\"repo path\"")
    #else
    assert(vman.shell_quote("repo path") == "'repo path'")
    assert(vman.shell_quote("it's") == "'it'\\''s'")
    #end
}
