
use vman
use valk.fs
use valk.json

@ignore_access

test "Project: validates package aliases" {
    assert(vman.is_valid_pkg_name("package"))
    assert(vman.is_valid_pkg_name("package_2"))
    assert(vman.is_valid_pkg_name("_private"))
    assert(!vman.is_valid_pkg_name(""))
    assert(!vman.is_valid_pkg_name("2package"))
    assert(!vman.is_valid_pkg_name("package-name"))
    assert(!vman.is_valid_pkg_name("package.name"))
}

synctest "Project: persists dependency configuration" {
    let debug_dir = fs.add((fs.cwd() !? "."), "debug")
    if !fs.is_dir(debug_dir) : fs.create_dir(debug_dir) ! {
        assert(false)
        return
    }

    let config_path = fs.add(debug_dir, "project-config-test.json")
    defer fs.delete_file(config_path) _

    let config: json.Value = json.new_object()
    let project = vman.Project {
        dir: debug_dir
        vendor_dir: fs.add(debug_dir, "vendor")
        config_path: config_path
        config: config
    }
    let source = vman.Source {
        type: vman.SRC.github
        name: "github.com.valk-lang.pkg-example"
        user_name: "valk-lang"
        repo_name: "pkg-example"
    }
    let pkg = vman.Package {
        project: project
        name: "github.com/valk-lang/pkg-example"
        dot_name: source.name
        id: fs.add(source.name, "1.2.3")
        pkg_dir: ""
        ver_dir: ""
        repo_dir: ""
        src: source
        ver: must_version("1.2.3")
        mask: must_mask("1.2.x")
        mask_given: true
    }
    pkg.ver.hash = "0123456789abcdef0123456789abcdef01234567"

    project.add_pkg_to_config(pkg, "example")

    let dependency = project.config.get("dependencies").get("example")
    assert(dependency.get("src").string == pkg.name)
    assert(dependency.get("current").string == "1.2.3")
    assert(dependency.get("current_hash").string == "0123456789abcdef0123456789abcdef01234567")
    assert(dependency.get("version").string == "1.2.x")
    assert(!dependency.has("installed"))
    assert(!dependency.has("update"))

    let written: json.Value = json.decode(fs.read(config_path) !? "") !? json.new_object()
    assert(written.get("dependencies").get("example").get("current").string == "1.2.3")
    assert(written.get("dependencies").get("example").get("current_hash").string == "0123456789abcdef0123456789abcdef01234567")

    // An exact version from the user is kept as it is
    pkg.mask = must_mask("1.2.3")
    project.add_pkg_to_config(pkg, "example")
    assert(project.config.get("dependencies").get("example").get("version").string == "1.2.3")

    pkg.ver = must_version("1.2.4")
    pkg.ver.hash = "abcdef0123456789abcdef0123456789abcdef0"
    pkg.mask = null
    pkg.mask_given = false
    project.add_pkg_to_config(pkg, "example")

    // Without a mask from the user the config keeps updates within the minor version
    let updated = project.config.get("dependencies").get("example")
    assert(updated.get("current").string == "1.2.4")
    assert(updated.get("current_hash").string == "abcdef0123456789abcdef0123456789abcdef0")
    assert(updated.get("version").string == "1.2.x")
}

synctest "Project: supplies the default mask for pinned dependencies" {
    let debug_dir = fs.add((fs.cwd() !? "."), "debug")
    if !fs.is_dir(debug_dir) : fs.create_dir(debug_dir) ! {
        assert(false)
        return
    }

    let config_path = fs.add(debug_dir, "project-default-mask-test.json")
    defer fs.delete_file(config_path) _

    let dep: json.Value = json.new_object()
    dep = dep.set("src", json.new_string("github.com/valk-lang/pkg-example"))
    dep = dep.set("current", json.new_string("1.2.3"))
    dep = dep.set("current_hash", json.new_string("0123456789abcdef0123456789abcdef01234567"))
    let dependencies: json.Value = json.new_object()
    dependencies = dependencies.set("example", dep)
    let config: json.Value = json.new_object()
    config = config.set("dependencies", dependencies)

    let vendor_dir = fs.add(debug_dir, "vendor")
    let installed_dir = fs.add(vendor_dir, "github-valk-lang-pkg-example/1.2.3")
    if !fs.is_dir(vendor_dir) : fs.create_dir(vendor_dir) ! assert(false)
    if !fs.is_dir(fs.add(vendor_dir, "github-valk-lang-pkg-example")) : fs.create_dir(fs.add(vendor_dir, "github-valk-lang-pkg-example")) ! assert(false)
    if !fs.is_dir(installed_dir) : fs.create_dir(installed_dir) ! assert(false)
    defer fs.delete_all(fs.add(vendor_dir, "github-valk-lang-pkg-example")) _

    let project = vman.Project {
        dir: debug_dir
        vendor_dir: vendor_dir
        config_path: config_path
        config: config
    }
    project.install_packages()

    let installed = project.config.get("dependencies").get("example")
    // A config without a mask gets the installed version with its last number open
    assert(installed.get("version").string == "1.2.x")
}

// Builds `dir` and every directory above it inside `root`
fn make_dirs(root: String, parts: Array[String]) String {
    let path = root
    each parts as part {
        path = fs.add(path, part)
        if !fs.is_dir(path) : fs.create_dir(path) ! return path
    }
    return path
}

fn write_config(dir: String, content: String) {
    fs.write(fs.add(dir, "valk.json"), content) ! {}
}

fn dependency_src(config_path: String, name: String) String {
    let conf: json.Value = json.decode(fs.read(config_path) !? "") !? json.new_object()
    return conf.get("dependencies").get(name).get("src").string
}

synctest "Project: points a package at the copy of its dependency in vendor" {
    let root = make_dirs((fs.cwd() !? "."), .{ "debug", "hoist-test" })
    fs.delete_all(root) _
    let vendor = make_dirs((fs.cwd() !? "."), .{ "debug", "hoist-test", "vendor" })

    // A package that depends on another package, as it arrives from its repository
    let pkg_dir = make_dirs(vendor, .{ "github-zikue-example", "1.0.0" })
    write_config(pkg_dir, "{\"name\":\"example\",\"dependencies\":{\"dep\":{\"src\":\"github.com/zikue/dep\",\"version\":\"0.1.x\",\"current\":\"0.1.2\",\"current_hash\":\"abc\"}}}")

    // Two versions of that dependency are already installed; the newest that fits the mask wins
    write_config(make_dirs(vendor, .{ "github-zikue-dep", "0.1.4" }), "{\"name\":\"dep\"}")
    write_config(make_dirs(vendor, .{ "github-zikue-dep", "0.2.0" }), "{\"name\":\"dep\"}")

    let project = vman.Project {
        dir: root
        vendor_dir: vendor
        config_path: fs.add(root, "valk.json")
        config: json.new_object()
    }

    // Nothing has to be downloaded, since a version that fits is already there
    let installed_something = project.hoist_round()
    assert(!installed_something)

    // The package now points at that directory, which is where the project's own dependency on
    // the same package resolves to as well: one directory, one package
    let src = dependency_src(fs.add(pkg_dir, "valk.json"), "dep")
    assert(src == "../../github-zikue-dep/0.1.4")
    assert(fs.is_dir(fs.add(pkg_dir, src)))

    // The pinned version is gone, so nothing points at the copy that is no longer used
    let conf: json.Value = json.decode(fs.read(fs.add(pkg_dir, "valk.json")) !? "") !? json.new_object()
    assert(!conf.get("dependencies").get("dep").has("current"))

    // A second pass leaves it alone
    assert(!project.hoist_round())
    assert(dependency_src(fs.add(pkg_dir, "valk.json"), "dep") == "../../github-zikue-dep/0.1.4")

    fs.delete_all(root) _
}

synctest "Project: a version that does not fit the mask is not reused" {
    let root = make_dirs((fs.cwd() !? "."), .{ "debug", "hoist-mask-test" })
    fs.delete_all(root) _
    let vendor = make_dirs((fs.cwd() !? "."), .{ "debug", "hoist-mask-test", "vendor" })

    let pkg_dir = make_dirs(vendor, .{ "github-zikue-example", "1.0.0" })
    write_config(pkg_dir, "{\"name\":\"example\",\"dependencies\":{\"dep\":{\"src\":\"github.com/zikue/dep\",\"version\":\"2.x.x\"}}}")
    write_config(make_dirs(vendor, .{ "github-zikue-dep", "1.5.0" }), "{\"name\":\"dep\"}")

    let project = vman.Project {
        dir: root
        vendor_dir: vendor
        config_path: fs.add(root, "valk.json")
        config: json.new_object()
    }

    // 1.5.0 does not fit `2.x.x`, so the package keeps asking for a package to install
    assert(!isset(project.vendored_version_for("github-zikue-dep", "2.x.x")))
    assert(isset(project.vendored_version_for("github-zikue-dep", "1.x.x")))

    fs.delete_all(root) _
}

test "Project: a warning when the valk in use is older than the project's" {
    let message = vman.active_valk_warning("0.7.7", must_version("0.7.6")) ?! { assert(false) return }
    assert(message.contains("uses valk 0.7.7") && message.contains("valk 0.7.6 is active") && message.contains("vman use"))
    assert(!isset(vman.active_valk_warning("0.7.7", must_version("0.7.7"))))
    assert(!isset(vman.active_valk_warning("0.7.6", must_version("0.7.7"))))
    assert(!isset(vman.active_valk_warning("", must_version("0.7.6"))))
    assert(!isset(vman.active_valk_warning("0.7.7", null)))
    assert(!isset(vman.active_valk_warning("latest", must_version("0.7.6"))))
}

synctest "Project: init creates and updates valk.json with flags" {
    let root = make_dirs((fs.cwd() !? "."), .{ "debug", "init-test" })
    fs.delete_all(root) _
    make_dirs((fs.cwd() !? "."), .{ "debug", "init-test" })
    defer fs.delete_all(root) _

    let path = fs.add(root, "valk.json")
    vman.init_config_at(path, "my_pkg", "v0.8.10", "0.8.0", must_version("0.8.1"), false)

    let conf: json.Value = json.decode(fs.read(path) !? "") !? json.new_object()
    assert(conf.get("name").string == "my_pkg")
    assert(conf.get("use").string == "0.8.10")
    assert(conf.get("require").get("valk").get("min").string == "0.8.0")

    // Re-running with existing config preserves fields and only updates passed flags
    conf = conf.set("dependencies", json.new_object())
    fs.write(path, conf.encode(true)) ! assert(false)
    vman.init_config_at(path, null, null, "0.8.5", must_version("0.8.10"), false)

    let updated: json.Value = json.decode(fs.read(path) !? "") !? json.new_object()
    assert(updated.get("name").string == "my_pkg")
    assert(updated.get("use").string == "0.8.10")
    assert(updated.get("require").get("valk").get("min").string == "0.8.5")
    assert(updated.has("dependencies"))

    // Without explicit --use, falls back to active valk version
    let path2 = fs.add(root, "valk2.json")
    vman.init_config_at(path2, null, null, null, must_version("0.8.10"), false)
    let conf2: json.Value = json.decode(fs.read(path2) !? "") !? json.new_object()
    assert(conf2.get("use").string == "0.8.10")
    assert(!conf2.has("name"))
    assert(!conf2.has("require"))
}

test "Project: validates frozen dependencies" {
    let valid = json.decode("{\"dependencies\":{\"cli\":{\"src\":\"github.com/zikue/valk-cli\",\"version\":\"0.3.x\",\"current\":\"0.3.1\",\"current_hash\":\"abc123\"},\"local\":{\"src\":\"../local\"}}}") !? json.new_object()
    assert(vman.validate_frozen_dependencies(valid).length == 0)

    let broken = json.decode("{\"dependencies\":{\"unpinned\":{\"src\":\"github.com/a/b\",\"version\":\"1.x\"},\"bad_ver\":{\"src\":\"github.com/a/c\",\"current\":\"nope\",\"current_hash\":\"abc\",\"version\":\"bad\"},\"no_src\":{}}}") !? json.new_object()
    let problems = vman.validate_frozen_dependencies(broken)
    assert(problems.length == 5)
    assert(problems.join("\n").contains("unpinned"))
    assert(problems.join("\n").contains("bad_ver"))
    assert(problems.join("\n").contains("no_src"))
}

synctest "Project: frozen install does not modify valk.json" {
    let root = make_dirs((fs.cwd() !? "."), .{ "debug", "frozen-install-test" })
    fs.delete_all(root) _
    let vendor = make_dirs((fs.cwd() !? "."), .{ "debug", "frozen-install-test", "vendor" })
    defer fs.delete_all(root) _

    make_dirs(vendor, .{ "github-valk-lang-pkg-example", "1.2.3" })
    let raw = "{\"dependencies\":{\"example\":{\"src\":\"github.com/valk-lang/pkg-example\",\"current\":\"1.2.3\",\"current_hash\":\"0123456789abcdef\"}}}"
    let config_path = fs.add(root, "valk.json")
    fs.write(config_path, raw) ! assert(false)

    let conf: json.Value = json.decode(raw) !? json.new_object()
    let project = vman.Project {
        dir: root
        vendor_dir: vendor
        config_path: config_path
        config: conf
    }
    project.install_packages(0, false, true)

    // Frozen install must leave valk.json byte-for-byte untouched
    assert((fs.read(config_path) !? "") == raw)
}

synctest "Project: clean_vendor preserves hoisted transitive dependencies and removes unused ones" {
    let root = make_dirs((fs.cwd() !? "."), .{ "debug", "clean-vendor-test" })
    fs.delete_all(root) _
    let vendor = make_dirs((fs.cwd() !? "."), .{ "debug", "clean-vendor-test", "vendor" })
    defer fs.delete_all(root) _

    // Root depends on pkg-a 1.0.0; pkg-a depends on hoisted dep 0.1.4; dep depends on hoisted leaf 0.2.0 (and cycle back to pkg-a)
    let pkg_a = make_dirs(vendor, .{ "github-zikue-pkg-a", "1.0.0" })
    write_config(pkg_a, "{\"name\":\"pkg_a\",\"dependencies\":{\"dep\":{\"src\":\"../../github-zikue-dep/0.1.4\"}}}")

    let dep_used = make_dirs(vendor, .{ "github-zikue-dep", "0.1.4" })
    write_config(dep_used, "{\"name\":\"dep\",\"dependencies\":{\"leaf\":{\"src\":\"../../github-zikue-leaf/0.2.0\"}}}")

    let leaf_used = make_dirs(vendor, .{ "github-zikue-leaf", "0.2.0" })
    write_config(leaf_used, "{\"name\":\"leaf\",\"dependencies\":{\"back\":{\"src\":\"../../github-zikue-pkg-a/1.0.0\"}}}")

    // Unused version of dep and unused unrelated package
    let dep_unused = make_dirs(vendor, .{ "github-zikue-dep", "0.2.0" })
    write_config(dep_unused, "{\"name\":\"dep\"}")
    let orphan = make_dirs(vendor, .{ "github-zikue-orphan", "1.0.0" })
    write_config(orphan, "{\"name\":\"orphan\"}")

    let config: json.Value = json.decode("{\"dependencies\":{\"pkg_a\":{\"src\":\"github.com/zikue/pkg-a\",\"current\":\"1.0.0\",\"current_hash\":\"abc\"}}}") !? json.new_object()
    let project = vman.Project {
        dir: root
        vendor_dir: vendor
        config_path: fs.add(root, "valk.json")
        config: config
    }

    let removed = project.clean_vendor()
    assert(removed == 2)
    assert(fs.is_dir(pkg_a))
    assert(fs.is_dir(dep_used))
    assert(fs.is_dir(leaf_used))
    assert(!fs.is_dir(dep_unused))
    assert(!fs.is_dir(fs.add(vendor, "github-zikue-orphan")))

    // Second clean is a no-op
    assert(project.clean_vendor() == 0)
}

test "Msg: extracts relevant git error lines" {
    assert(vman.git_error_detail("Cloning into 'x'...\nfatal: repository 'https://example.com/a.git/' not found\n") == "fatal: repository 'https://example.com/a.git/' not found")
    assert(vman.git_error_detail("remote: Not Found\nfatal: could not read Username\nerror: extra\n") == "remote: Not Found; fatal: could not read Username")
    assert(vman.git_error_detail("some plain error\r\n") == "some plain error")
    assert(vman.git_error_detail("   \n\n  ") == "")
}
