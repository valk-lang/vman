
use vman
use valk.fs
use valk.json

@ignore_access

test "Project: validates package aliases" {
    assert(vman.is_valid_pkg_name("package"))
    assert(vman.is_valid_pkg_name("package_2"))
    assert(vman.is_valid_pkg_name("_private"))
    assert(!vman.is_valid_pkg_name(""))
    assert(!vman.is_valid_pkg_name("2package"))
    assert(!vman.is_valid_pkg_name("package-name"))
    assert(!vman.is_valid_pkg_name("package.name"))
}

synctest "Project: persists dependency configuration" {
    let debug_dir = fs.add((fs.cwd() !? "."), "debug")
    if !fs.is_dir(debug_dir) : fs.create_dir(debug_dir) ! {
        assert(false)
        return
    }

    let config_path = fs.add(debug_dir, "project-config-test.json")
    defer fs.delete_file(config_path) _

    let config: json.Value = json.new_object()
    let project = vman.Project {
        dir: debug_dir
        vendor_dir: fs.add(debug_dir, "vendor")
        config_path: config_path
        config: config
    }
    let source = vman.Source {
        type: vman.SRC.github
        name: "github.com.valk-lang.pkg-example"
        user_name: "valk-lang"
        repo_name: "pkg-example"
    }
    let pkg = vman.Package {
        project: project
        name: "github.com/valk-lang/pkg-example"
        dot_name: source.name
        id: fs.add(source.name, "1.2.3")
        pkg_dir: ""
        ver_dir: ""
        repo_dir: ""
        src: source
        ver: must_version("1.2.3")
        mask: must_mask("1.2.x")
    }
    pkg.ver.hash = "0123456789abcdef0123456789abcdef01234567"

    project.add_pkg_to_config(pkg, "example")

    let dependency = project.config.get("dependencies").get("example")
    assert(dependency.get("src").string == pkg.name)
    assert(dependency.get("current").string == "1.2.3")
    assert(dependency.get("current_hash").string == "0123456789abcdef0123456789abcdef01234567")
    assert(dependency.get("version").string == "1.2.x")
    assert(!dependency.has("installed"))
    assert(!dependency.has("update"))

    let written: json.Value = json.decode(fs.read(config_path) !? "") !? json.new_object()
    assert(written.get("dependencies").get("example").get("current").string == "1.2.3")
    assert(written.get("dependencies").get("example").get("current_hash").string == "0123456789abcdef0123456789abcdef01234567")

    pkg.ver = must_version("1.2.4")
    pkg.ver.hash = "abcdef0123456789abcdef0123456789abcdef0"
    pkg.mask = null
    project.add_pkg_to_config(pkg, "example")

    let updated = project.config.get("dependencies").get("example")
    assert(updated.get("current").string == "1.2.4")
    assert(updated.get("current_hash").string == "abcdef0123456789abcdef0123456789abcdef0")
    assert(updated.get("version").string == "x.x.x")
}

synctest "Project: supplies the default mask for pinned dependencies" {
    let debug_dir = fs.add((fs.cwd() !? "."), "debug")
    if !fs.is_dir(debug_dir) : fs.create_dir(debug_dir) ! {
        assert(false)
        return
    }

    let config_path = fs.add(debug_dir, "project-default-mask-test.json")
    defer fs.delete_file(config_path) _

    let dep: json.Value = json.new_object()
    dep = dep.set("src", json.new_string("github.com/valk-lang/pkg-example"))
    dep = dep.set("current", json.new_string("1.2.3"))
    dep = dep.set("current_hash", json.new_string("0123456789abcdef0123456789abcdef01234567"))
    let dependencies: json.Value = json.new_object()
    dependencies = dependencies.set("example", dep)
    let config: json.Value = json.new_object()
    config = config.set("dependencies", dependencies)

    let vendor_dir = fs.add(debug_dir, "vendor")
    let installed_dir = fs.add(vendor_dir, "github-valk-lang-pkg-example/1.2.3")
    if !fs.is_dir(vendor_dir) : fs.create_dir(vendor_dir) ! assert(false)
    if !fs.is_dir(fs.add(vendor_dir, "github-valk-lang-pkg-example")) : fs.create_dir(fs.add(vendor_dir, "github-valk-lang-pkg-example")) ! assert(false)
    if !fs.is_dir(installed_dir) : fs.create_dir(installed_dir) ! assert(false)
    defer fs.delete_all(fs.add(vendor_dir, "github-valk-lang-pkg-example")) _

    let project = vman.Project {
        dir: debug_dir
        vendor_dir: vendor_dir
        config_path: config_path
        config: config
    }
    project.install_packages()

    let installed = project.config.get("dependencies").get("example")
    assert(installed.get("version").string == "x.x.x")
}

// Builds `dir` and every directory above it inside `root`
fn make_dirs(root: String, parts: Array[String]) String {
    let path = root
    each parts as part {
        path = fs.add(path, part)
        if !fs.is_dir(path) : fs.create_dir(path) ! return path
    }
    return path
}

fn write_config(dir: String, content: String) {
    fs.write(fs.add(dir, "valk.json"), content) ! {}
}

fn dependency_src(config_path: String, name: String) String {
    let conf: json.Value = json.decode(fs.read(config_path) !? "") !? json.new_object()
    return conf.get("dependencies").get(name).get("src").string
}

synctest "Project: points a package at the copy of its dependency in vendor" {
    let root = make_dirs((fs.cwd() !? "."), .{ "debug", "hoist-test" })
    fs.delete_all(root) _
    let vendor = make_dirs((fs.cwd() !? "."), .{ "debug", "hoist-test", "vendor" })

    // A package that depends on another package, as it arrives from its repository
    let pkg_dir = make_dirs(vendor, .{ "github-ctxcode-example", "1.0.0" })
    write_config(pkg_dir, "{\"name\":\"example\",\"dependencies\":{\"dep\":{\"src\":\"github.com/ctxcode/dep\",\"version\":\"0.1.x\",\"current\":\"0.1.2\",\"current_hash\":\"abc\"}}}")

    // Two versions of that dependency are already installed; the newest that fits the mask wins
    write_config(make_dirs(vendor, .{ "github-ctxcode-dep", "0.1.4" }), "{\"name\":\"dep\"}")
    write_config(make_dirs(vendor, .{ "github-ctxcode-dep", "0.2.0" }), "{\"name\":\"dep\"}")

    let project = vman.Project {
        dir: root
        vendor_dir: vendor
        config_path: fs.add(root, "valk.json")
        config: json.new_object()
    }

    // Nothing has to be downloaded, since a version that fits is already there
    let installed_something = project.hoist_round()
    assert(!installed_something)

    // The package now points at that directory, which is where the project's own dependency on
    // the same package resolves to as well: one directory, one package
    let src = dependency_src(fs.add(pkg_dir, "valk.json"), "dep")
    assert(src == "../../github-ctxcode-dep/0.1.4")
    assert(fs.is_dir(fs.add(pkg_dir, src)))

    // The pinned version is gone, so nothing points at the copy that is no longer used
    let conf: json.Value = json.decode(fs.read(fs.add(pkg_dir, "valk.json")) !? "") !? json.new_object()
    assert(!conf.get("dependencies").get("dep").has("current"))

    // A second pass leaves it alone
    assert(!project.hoist_round())
    assert(dependency_src(fs.add(pkg_dir, "valk.json"), "dep") == "../../github-ctxcode-dep/0.1.4")

    fs.delete_all(root) _
}

synctest "Project: a version that does not fit the mask is not reused" {
    let root = make_dirs((fs.cwd() !? "."), .{ "debug", "hoist-mask-test" })
    fs.delete_all(root) _
    let vendor = make_dirs((fs.cwd() !? "."), .{ "debug", "hoist-mask-test", "vendor" })

    let pkg_dir = make_dirs(vendor, .{ "github-ctxcode-example", "1.0.0" })
    write_config(pkg_dir, "{\"name\":\"example\",\"dependencies\":{\"dep\":{\"src\":\"github.com/ctxcode/dep\",\"version\":\"2.x.x\"}}}")
    write_config(make_dirs(vendor, .{ "github-ctxcode-dep", "1.5.0" }), "{\"name\":\"dep\"}")

    let project = vman.Project {
        dir: root
        vendor_dir: vendor
        config_path: fs.add(root, "valk.json")
        config: json.new_object()
    }

    // 1.5.0 does not fit `2.x.x`, so the package keeps asking for a package to install
    assert(!isset(project.vendored_version_for("github-ctxcode-dep", "2.x.x")))
    assert(isset(project.vendored_version_for("github-ctxcode-dep", "1.x.x")))

    fs.delete_all(root) _
}

test "Project: a warning when the valk in use is older than the project's" {
    let message = vman.active_valk_warning("0.7.7", must_version("0.7.6")) ?! { assert(false) return }
    assert(message.contains("uses valk 0.7.7") && message.contains("valk 0.7.6 is active") && message.contains("vman use"))
    assert(!isset(vman.active_valk_warning("0.7.7", must_version("0.7.7"))))
    assert(!isset(vman.active_valk_warning("0.7.6", must_version("0.7.7"))))
    assert(!isset(vman.active_valk_warning("", must_version("0.7.6"))))
    assert(!isset(vman.active_valk_warning("0.7.7", null)))
    assert(!isset(vman.active_valk_warning("latest", must_version("0.7.6"))))
}
