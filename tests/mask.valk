
use vman

@ignore_access

fn mask_is_invalid(name: String) bool {
    vman.Mask.new(name) ! {
        return E.code == E.invalid
    }
    return false
}

test "Mask: recognizes wildcard syntax" {
    assert(vman.Mask.is_mask("x"))
    assert(vman.Mask.is_mask("1.x"))
    assert(vman.Mask.is_mask("1.2.x"))
    assert(vman.Mask.is_mask("1.x.3"))
    assert(vman.Mask.is_mask("x.x.x"))

    assert(!vman.Mask.is_mask(""))
    assert(!vman.Mask.is_mask("1.2.3"))
    assert(!vman.Mask.is_mask("1.2.3.4"))
    assert(!vman.Mask.is_mask("1.y.3"))
}

test "Mask: rejects invalid syntax" {
    assert(mask_is_invalid(""))
    assert(mask_is_invalid("1"))
    assert(mask_is_invalid("1.2"))
    assert(mask_is_invalid("1..x"))
    assert(mask_is_invalid("1.y.3"))
    assert(mask_is_invalid("1.2.3.4"))
    assert(mask_is_invalid("-1.x"))
}

test "Mask: matches compatible versions" {
    let patch_mask = must_mask("1.2.x")
    assert(patch_mask.is_compat(must_version("1.2.0")))
    assert(patch_mask.is_compat(must_version("1.2.99")))
    assert(!patch_mask.is_compat(must_version("1.3.0")))
    assert(!patch_mask.is_compat(must_version("2.2.0")))

    let minor_mask = must_mask("1.x")
    assert(minor_mask.is_compat(must_version("1.0.0")))
    assert(minor_mask.is_compat(must_version("1.99.99")))
    assert(!minor_mask.is_compat(must_version("2.0.0")))
}

test "Mask: matches partial wildcard masks" {
    let middle_mask = must_mask("1.x.3")
    assert(middle_mask.is_compat(must_version("1.0.3")))
    assert(middle_mask.is_compat(must_version("1.5.3")))
    assert(middle_mask.is_compat(must_version("1.99.3")))
    assert(!middle_mask.is_compat(must_version("1.0.4")))
    assert(!middle_mask.is_compat(must_version("2.0.3")))

    let any_mask = must_mask("x")
    assert(any_mask.is_compat(must_version("0.0.1")))
    assert(any_mask.is_compat(must_version("9.9.9")))
}

test "Mask: exact version matches only that version" {
    let exact = must_mask("1.2.3")
    assert(exact.is_compat(must_version("1.2.3")))
    assert(!exact.is_compat(must_version("1.2.4")))
    assert(!exact.is_compat(must_version("1.3.3")))
}

test "Mask: a dependency installed without a mask records the compatible range" {
    assert(vman.Mask.compatible_with(must_version("0.2.3")).name == "0.2.x")
    assert(vman.Mask.compatible_with(must_version("v1.4.0")).name == "1.x.x")
    assert(vman.Mask.compatible_with(must_version("12.0.9")).name == "12.x.x")
    assert(vman.Mask.compatible_with(must_version("0.0.7")).name == "0.0.7")
    // A 0.x update to the next minor may break: it is outside the range
    let pinned = vman.Mask.compatible_with(must_version("0.1.0"))
    assert(pinned.is_compat(must_version("0.1.5")))
    assert(!pinned.is_compat(must_version("0.2.0")))
    let major = vman.Mask.compatible_with(must_version("2.1.0"))
    assert(major.is_compat(must_version("2.9.0")))
    assert(!major.is_compat(must_version("3.0.0")))
    // A tag that is not a version allows any version
    assert(vman.Mask.compatible_with(vman.Version { name: "main" }).name == "x.x.x")
}
