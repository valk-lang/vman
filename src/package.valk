
use valk.json
use valk.fs
use valk.core

class Package {
    project: Project
    name: String
    dot_name: String
    id: String
    pkg_dir: String
    ver_dir: String
    repo_dir: String
    src: Source
    ver: Version
    mask: ?Mask (null)
    // Whether the user gave the version mask; otherwise the config records a compatible one
    mask_given: bool (false)
    require: ?ValkRequire (null)
    conf: ?json.Value (null)

    static fn init(project: Project, name: String, request: ?String) Package {

        let src = Source.new(name)
        let requested_mask = request ?? "x.x.x"
        let mask = Mask.new(requested_mask) ! error("Invalid version mask: " + requested_mask)

        let versions = src.get_versions()
        if versions.length == 0 : error("Package '%name' hasnt created any versions yet")

        let repo_dir = fs.add(cache_repo_dir(), src.name)
        let require_of = fn(v: Version) ValkRequire {
            return require_at(repo_dir, v.hash)
        }

        // The valk version of the project decides which package versions qualify
        let valk = project.valk_version()
        if isset(valk) : ensure_repo(src, repo_dir)

        // Resolve the latest tagged version that matches the requested mask and supports the project valk version
        let ver = pick_version(name, versions, mask, valk, require_of)

        let pkg_dir = fs.add(project.vendor_dir, src.assoc_name())
        let ver_dir = fs.add(pkg_dir, ver.name)
        let require: ?ValkRequire = null
        if isset(valk) : require = require_of(ver)

        return Package {
            project: project
            name: name
            dot_name: src.name
            id: fs.add(src.name, ver.name)
            pkg_dir: pkg_dir
            ver_dir: ver_dir
            repo_dir: repo_dir
            src: src
            ver: ver
            mask: mask
            mask_given: isset(request)
            require: require
        }
    }

    static fn from_config(project: Project, name: String, version: Version, hash: String) Package {

        let src = Source.new(name)
        let ver = version
        ver.hash = hash

        let pkg_dir = fs.add(project.vendor_dir, src.assoc_name())
        let ver_dir = fs.add(pkg_dir, ver.name)

        return Package {
            project: project
            name: name
            dot_name: src.name
            id: fs.add(src.name, ver.name)
            pkg_dir: pkg_dir
            ver_dir: ver_dir
            repo_dir: fs.add(cache_repo_dir(), src.name)
            src: src
            ver: ver
            mask: null
        }
    }

    fn installed() bool {
        return fs.exists(this.ver_dir)
    }
    fn install() {
        let repo_dir = this.repo_dir
        let dest_dir = this.ver_dir
        let hash = this.ver.hash
        if hash.is_empty() : error("Package '%{this.name}' has no commit hash to install")

        ensure_repo(this.src, repo_dir)

        // Checkout commit
        let cmd = "git -C " + shell_quote(repo_dir) + " checkout " + shell_quote(hash)
        let checkout_code, _ = core.exec(cmd)
        if checkout_code != 0 : error("Package commit not found: %hash")

        // Copy files to the version directory
        let files = fs.files_in(repo_dir, false) ! error("Failed to read directory")
        if !fs.exists(this.pkg_dir) : fs.create_dir(this.pkg_dir) ! error("Failed to create directory: " + this.pkg_dir)
        if !fs.exists(dest_dir) : fs.create_dir(dest_dir) ! error("Failed to create directory: " + dest_dir)
        each files as file {
            let fn = fs.basename(file)
            if fn == ".git" : continue
            fs.copy(file, fs.add(dest_dir, fn), true) _
        }
    }
    fn config() json.Value {
        let conf = this.conf
        if isset(conf) : return conf

        let path = fs.add(this.repo_dir, "valk.json")
        let str = fs.read(path) ! error("Package is missing a valk.json config: " + path)
        conf = json.decode(str) ! error("Invalid json syntax in config: " + path)

        this.conf = conf
        return conf
    }
}

global fetched_repos : Array[String] (.{})

// Clones the package repository, or fetches it once per run so new tags are known
fn ensure_repo(src: Source, dir: String) {
    if fetched_repos.contains(dir) : return
    fetched_repos.append(dir)

    if !fs.exists(dir) {
        let cmd = "git clone " + shell_quote(src.clone_url()) + " " + shell_quote(dir)
        let code, _ = core.exec(cmd)
        if code == 127 : error("Git is not installed")
        if code != 0 : error("Failed to clone package: %cmd")
        return
    }

    let cmd = "git -C " + shell_quote(dir) + " fetch --tags"
    let code, _ = core.exec(cmd)
    if code == 127 : error("Git is not installed")
    if code != 0 : error("Failed to fetch package repository: %cmd")
}
