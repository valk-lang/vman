
use valk:ansi

fn emo(emo: String, alt: String) String {
    return ansi:supported() ? emo : alt
}

fn main(args: Array[String]) {

    let options = extract_options(args)

    args.remove(0)
    let action = args.get(0) ! help(0)
    args.remove(0)

    if options.contains("-h") || options.contains("--help") : help(0)

    if action == "use" {
        cmd_use(args, options)
    } else if action == "init" {
        Project.init_config()
    } else if action == "install" {
        cmd_package_install(args, options)
    } else if action == "update" {
        cmd_package_update()
    } else if action == "remove" {
        cmd_package_remove(args, options)
    } else if action == "self-update" {
        self_update()
    } else if action == "clean" {
        cmd_clean(args)
    } else if action == "unuse" {
        cmd_unuse(args, options)
    } else if action == "version" {
        println(VERSION)
    } else if action == "fetch" {
        let arg0 = args.get(0) !? ""
        fetch(arg0 == "true")
        println("# Saved versions to " + versions_json_path())
    } else {
        println("Unknown command: '" + action + "'")
        exit(1)
    }
}

fn help(code: i32) $exit {
    println("-----------------------------")
    println(" Valk package manager " + VERSION)
    println("-----------------------------")
    print("\n")
    println(emo("📦", "#") + " Package commands")
    print("\n")
    println(" vman init              Initialize a valk.json config")
    println(" vman install           Install packages defined in valk.json")
    println(" vman install {pkg} [{version-mask}]")
    println("                        Install a package in the current project")
    println(" vman update            Update packages to the latest matching versions")
    println(" vman remove {pkg}      Remove a package by name")
    print("\n")
    println(emo("💿", "#") + " Valk version control")
    print("\n")
    println(" vman use 0.3.4         Install valk version 0.3.4")
    println(" vman use               Install the version from valk.json")
    println(" vman use latest        Install latest version")
    println(" vman use dev           Install the dev valk version")
    println(" vman unuse {version}   Remove an installed Valk version")
    print("\n")
    println(emo("⚙️", "#") + " Other");
    print("\n")
    println(" vman version           Show vman version");
    println(" vman self-update       Update vman itself");
    print("\n")
    println(" vman clean packages    Remove unused vendor packages");
    println(" vman clean cache       Clear cached requests and downloads");
    println(" vman clean repos       Remove cloned package repositories");

    print("\n")

    exit(code)
}


fn extract_options(args: Array[String]) Array[String] {
    let options = Array[String]{}
    each args as arg, i {
        if arg.starts_with("-") {
            options.append(arg)
            args.remove(i--)
        }
    }
    return options
}
