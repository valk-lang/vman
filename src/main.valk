use cli
use valk.ansi
use valk.fs

fn emo(emo: String, alt: String) String {
    return ansi.supported() ? emo : alt
}

fn main(args: Array[String]) {
    exit(build_app().run(args))
}

/// The commands vman answers to. `main` runs it; a test reads it.
fn build_app() cli.App {
    let app = cli.App.new("vman", "Valk package manager", VERSION)
    app.root.description = "Installs packages for a project, and the valk versions to build it with."

    // Packages
    let install = cli.Command.new("install", "Install the packages of this project, or add one")
    install.argument("package", "A package such as github.com/user/repo; left out, every dependency of the project", false)
    install.argument("version", "The versions to allow, such as 0.2.x", false)
    install.argument("alias", "The name to use the package under", false)
    install.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_package_install(ctx.has_arg("package") ? ctx.arg("package") : null, ctx.has_arg("version") ? ctx.arg("version") : null, ctx.has_arg("alias") ? ctx.arg("alias") : null)
        return 0
    })
    install.complete_argument("package", fn(words: Array[String]) Array[String] {
        return project_package_names()
    })

    let update = cli.Command.new("update", "Update the packages to the newest versions they allow")
    update.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_package_update()
        return 0
    })

    let remove = cli.Command.new("remove", "Remove a package from this project")
    remove.argument("package", "The name it is used under", true)
    remove.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_package_remove(ctx.arg("package"))
        return 0
    })
    remove.complete_argument("package", fn(words: Array[String]) Array[String] {
        return project_dependency_names()
    })

    let versions = cli.Command.new("versions", "List the versions of a package, and the valk versions they need")
    versions.argument("package", "A package such as github.com/user/repo", true)
    versions.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_package_versions(ctx.arg("package"))
        return 0
    })
    versions.complete_argument("package", fn(words: Array[String]) Array[String] {
        return project_package_names()
    })

    let init = cli.Command.new("init", "Write a valk.json for this project")
    init.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        Project.init_config()
        return 0
    })

    let template = cli.Command.new("template", "Write starting code into this project")
    template.description = "Without a name, every template is listed. The files are written into `directory`, which is the project itself by default and has to be empty; a template that needs a package installs it."
    template.argument("name", "The template to write; left out, the templates are listed", false)
    template.argument("directory", "An empty directory to write the files in, made when it is not there; this one when it is empty, ./{template} otherwise", false)
    template.flag("force", "f", "Write over files that are already there")
    template.flag("export", "e", "Copy the template into your own templates directory, to edit it")
    template.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        if !ctx.has_arg("name") {
            cmd_template_list()
            return 0
        }
        if ctx.flag("export") {
            cmd_template_export(ctx.arg("name"), ctx.flag("force"))
            return 0
        }
        cmd_template_write(ctx.arg("name"), ctx.has_arg("directory") ? ctx.arg("directory") : null, ctx.flag("force"))
        return 0
    })
    template.complete_argument("name", fn(words: Array[String]) Array[String] {
        return template_names()
    })

    // Programs, installed for your user rather than for a project
    let global_command = cli.Command.new("global", "Install the programs a package offers, for your user")
    global_command.description = "A package says what it offers with `exe` in its valk.json. Its programs are built and linked into ~/.local/bin. Without a command, what is installed is listed."
    global_command.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_global_list()
        return 0
    })

    let global_install = cli.Command.new("install", "Install a package and link its programs")
    global_install.argument("package", "A package such as github.com/user/repo", true)
    global_install.argument("version", "The versions to allow, such as 0.2.x", false)
    global_install.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_global_install(ctx.arg("package"), ctx.has_arg("version") ? ctx.arg("version") : null)
        return 0
    })

    let global_remove = cli.Command.new("remove", "Remove a package and the programs it linked")
    global_remove.argument("package", "The name it is installed under", true)
    global_remove.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_global_remove(ctx.arg("package"))
        return 0
    })
    global_remove.complete_argument("package", fn(words: Array[String]) Array[String] {
        return global_package_names()
    })

    let global_update = cli.Command.new("update", "Install every one of them again, at the newest version it allows")
    global_update.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_global_update()
        return 0
    })

    let global_list = cli.Command.new("list", "List what is installed for your user")
    global_list.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_global_list()
        return 0
    })

    global_command.command(global_install)
    global_command.command(global_remove)
    global_command.command(global_update)
    global_command.command(global_list)

    // Valk versions
    let use_command = cli.Command.new("use", "Install a valk version and make it the one in use")
    use_command.argument("version", "A version, `latest`, `dev`, or nothing for the one in valk.json", false)
    use_command.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_use(ctx.has_arg("version") ? ctx.arg("version") : null)
        return 0
    })
    use_command.complete_argument("version", fn(words: Array[String]) Array[String] {
        let names = Array[String]{ "latest", "dev" }
        names.append_many(installed_version_names())
        return names
    })

    let unuse = cli.Command.new("unuse", "Remove an installed valk version")
    unuse.argument("version", "The version to remove", true)
    unuse.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_unuse(ctx.arg("version"))
        return 0
    })
    unuse.complete_argument("version", fn(words: Array[String]) Array[String] {
        return installed_version_names()
    })

    // Other
    let self_update_command = cli.Command.new("self-update", "Update vman itself")
    self_update_command.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        self_update()
        return 0
    })

    let clean = cli.Command.new("clean", "Remove what is no longer needed")
    clean.argument("what", "packages, cache or repos", true)
    clean.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        cmd_clean(ctx.arg("what"))
        return 0
    })
    clean.complete_argument("what", fn(words: Array[String]) Array[String] {
        return .{ "packages", "cache", "repos" }
    })

    // `vman version` was there before `--version` was, and scripts use it
    let version_command = cli.Command.new("version", "Show the version of vman")
    version_command.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        println(VERSION)
        return 0
    })

    let fetch_command = cli.Command.new("fetch", "Save the list of released versions")
    fetch_command.argument("force", "true to fetch even when the list is fresh", false)
    fetch_command.on_run(fn(ctx: cli.Context) i32 !cli.Error {
        fetch(ctx.arg("force") == "true")
        println("# Saved versions to " + versions_json_path())
        return 0
    })

    app.root.command(install)
    app.root.command(update)
    app.root.command(remove)
    app.root.command(versions)
    app.root.command(init)
    app.root.command(template)
    app.root.command(global_command)
    app.root.command(use_command)
    app.root.command(unuse)
    app.root.command(self_update_command)
    app.root.command(clean)
    app.root.command(version_command)
    app.root.command(fetch_command)
    app.add_completion_command()
    return app
}

// The valk versions that are installed, newest first
fn installed_version_names() Array[String] {
    let names = Array[String]{}
    let dirs = fs.files_in(versions_dir(), false, false, true) !? .{}
    each dirs as dir {
        let name = fs.basename(dir)
        Version.new(name) ! continue
        names.append(name)
    }
    names.sort()
    names.reverse()
    return names
}

// The names this project uses its dependencies under
fn project_dependency_names() Array[String] {
    let names = Array[String]{}
    if !fs.exists(Project.get_config_path()) : return names
    let project = Project.load()
    let deps = project.config.get("dependencies").object
    each deps.values.keys() as key : names.append(key)
    return names
}

// The packages this project already names, which is what `install` and `versions` usually mean
fn project_package_names() Array[String] {
    let names = Array[String]{}
    if !fs.exists(Project.get_config_path()) : return names
    let project = Project.load()
    let deps = project.config.get("dependencies").object
    each deps.values as dep, key {
        let src = dep.get("src").string
        if src.length > 0 && !fs.is_dir(src) : names.append(src)
    }
    return names
}
