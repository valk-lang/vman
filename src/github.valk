
use valk:json
use valk:http
use valk:time

error GithubError (fail)

fn github_req(method: String, path: String) json:Value !GithubError {
    let url = "https://api.github.com" + path

    let cache = Cache.get()
    let reqs = cache.data.get("requests")
    let id = VERSION + ":%method:%url"
    let req = reqs.get(id)
    let when = req.get("when").int().to(uint)
    let body = req.get("body").string()
    let now = time:mstime()
    if now - when < 5 * 60 * 1000 && !body.is_empty() {
        let data = json:decode(body) !? null
        if isset(data) {
            return data
        }
    }

    // println("REQUEST : %method %url")
    let options = http:Options{}
    options.set_header("User-Agent", "Vpkg package manager " + VERSION)
    let res = http:request(method, url, options) ! {
        println("# Request failed: " + url)
        throw .fail
    }
    if res.status != 200 : throw .fail
    //
    let data = json:decode(res.body) ! throw .fail
    // Update cache
    req = req.set("when", json:new_int(now.to(int)))
    req = req.set("body", json:new_string(res.body))
    reqs = reqs.set(id, req)
    cache.data = cache.data.set("requests", reqs)
    cache.save()
    //
    return data
}

fn github_exists(user: String, repo: String) bool {
    let data = github_req("GET", "/repos/%user/%repo") ! return false
    let id = data.get("id").int()
    // println("id: " + id)
    return id != 0
}
