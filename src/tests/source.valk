
use main

@ignore_access

fn source_with_versions(names: Array[String]) main:Source {
    let versions = Array[main:Version]{}
    each names as name : versions.append(must_version(name))
    return main:Source {
        type: main:SRC.github
        name: "github.com.valk-lang.test-package"
        user_name: "valk-lang"
        repo_name: "test-package"
        versions: versions
    }
}

test "Source: parses GitHub package names" {
    let source = main:Source.new("github.com/valk-lang/pkg-example")
    assert(source.type == main:SRC.github)
    assert(source.name == "github.com.valk-lang.pkg-example")
    assert(source.user_name == "valk-lang")
    assert(source.repo_name == "pkg-example")
    assert(source.to(String) == source.name)
}

test "Source: validates package names" {
    assert(main:is_valid_source_name("github.com/valk-lang/pkg-example"))
    assert(!main:is_valid_source_name("github.com//pkg-example"))
    assert(!main:is_valid_source_name("github.com/valk-lang/"))
    assert(!main:is_valid_source_name("github.com/valk lang/pkg-example"))
    assert(!main:is_valid_source_name("gitlab.com/valk-lang/pkg-example"))
}

test "Source: selects the highest compatible version" {
    let source = source_with_versions(.{ "1.2.3", "2.0.0", "1.10.0", "1.3.1" })
    let highest = source.get_highest_version(null) !? must_version("0.0.0")
    assert(highest.name == "2.0.0")

    let compatible = source.get_highest_version(main:Mask.new("1.x")) !? must_version("0.0.0")
    assert(compatible.name == "1.10.0")

    let missing: ?main:Version = source.get_highest_version(main:Mask.new("3.x")) !? null
    assert(!isset(missing))
}
