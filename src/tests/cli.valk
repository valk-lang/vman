
use main

@ignore_access

test "CLI: extracts options without disturbing arguments" {
    let args = Array[String] { "vman", "install", "-h", "pkg", "--force" }
    let options = main:extract_options(args)
    assert(options == Array[String] { "-h", "--force" })
    assert(args == Array[String] { "vman", "install", "pkg" })
}
