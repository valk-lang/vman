
error VersionError (invalid)

class Version {
    name: String
    hash: String ("")
    n1: uint (0)
    n2: uint (0)
    n3: uint (0)
    can_compare: bool (false)

    static fn new(name: String) SELF !VersionError {
        let v = name
        if v.starts_with("v") || v.starts_with("V") : v = v.part(1, v.length)

        let res = Version {
            name: name
        }

        let parts = v.split(".")
        if parts.length != 3 : throw .invalid

        let p1 = parts.get(0) !? ""
        let p2 = parts.get(1) !? ""
        let p3 = parts.get(2) !? ""
        if !p1.is_integer() || !p2.is_integer() || !p3.is_integer() : throw .invalid

        res.n1 = p1.to_uint() ! throw .invalid
        res.n2 = p2.to_uint() ! throw .invalid
        res.n3 = p3.to_uint() ! throw .invalid
        res.can_compare = true
        return res
    }

    fn str() String $to {
        return this.name
    }

    // Compare
    fn eq(v: Version) bool $eq {
        if this.name == v.name : return true
        if !this.can_compare || !v.can_compare : return false
        return this.n1 == v.n1 && this.n2 == v.n2 && this.n3 == v.n3
    }
    fn lt(v: Version) bool $lt {
        if this.eq(v) : return false
        if !this.can_compare || !v.can_compare : return this.name < v.name
        if this.n1 != v.n1 : return this.n1 < v.n1
        if this.n2 != v.n2 : return this.n2 < v.n2
        return this.n3 < v.n3
    }
    fn lte(v: Version) bool $lte {
        return this.lt(v) || this.eq(v)
    }
    fn gt(v: Version) bool $gt {
        return v.lt(this)
    }
    fn gte(v: Version) bool $gte {
        return this.gt(v) || this.eq(v)
    }
}
