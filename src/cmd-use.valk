
use valk:fs
use valk:ansi

fn cmd_use(args: Array[String], options: Array[String]) {

    let vv = get_versions()
    let version: ?Version = null
    let requested = args.get(0) !? null
    if isset(requested) {
        version = Version.new(requested) !? null
        if !isset(version) {
            fetch(false)
            vv = get_versions()
            version = resolve_valk_version(vv, requested)
        }
    } else {
        version = get_version_from_config()
    }

    if !isset(version) : error("Invalid version")

    check_vman_versions(vv)

    if !is_installed(version) {
        // Download version
        println("# Installing version: " + version.name)
        download_and_unzip_version(version)
    }

    // Link
    link_version(version)
    //
    if ansi:supported() : println("# Switched to version: " + version.name.ansi.green())
    else : println("# Switched to version: " + version.name)
}

fn is_installed(version: Version) bool {
    #if OS == win
    let path = version_dir(version) + "valk.exe"
    #else
    let path = version_dir(version) + "valk"
    #end
    return fs:exists(path)
}

fn link_version(version: Version) {
    let to = version_dir(version) + valk_exe()
    #if OS == win
    let link = bin_dir() + "valk.bat"
    #else
    let link = bin_dir() + valk_exe()
    #end

    // Check target
    if !fs:exists(to) : error("Tried to create a symbolic link to a file that does not exist: " + to)

    // Remove existing link (including a dangling one left behind by a removed version)
    fs:delete(link) ! warn("Failed to remove previous link: " + link)

    #if OS == win
    // Create bat file
    let content = "@echo off\n\"" + to + "\" \%*"
    fs:write(link, content) ! error("Failed to create symlink")
    #else
    // Create link
    fs:symlink(link, to, false) ! {
        if E.code == E.access : error("Failed to create symlink | Admin privileges required")
        if E.code == E.exists : error("Failed to create symlink | File already exists")
        error("Failed to create symlink")
    }
    #end

    // Message
    if ansi:supported() : println("# Link '" + link.ansi.blue() + "' to '" + to.ansi.blue() + "'")
    else : println("# Link '" + link + "' to '" + to + "'")
}
