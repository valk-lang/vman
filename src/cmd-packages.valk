
use valk.ansi
use valk.fs

fn cmd_package_install(install_pkg_name: ?String, install_mask: ?String, alias: ?String) {

    // Project
    let p = Project.new()

    if isset(install_pkg_name) {
        // Package
        let pkg = Package.init(p, install_pkg_name, install_mask)

        p.packages.set(pkg.id, pkg)

        // Install
        pkg.install()

        // The package brings its own dependencies; they are installed next to it
        p.install_nested_dependencies()

        // Add to config
        p.add_pkg_to_config(pkg, alias)

        // Success
        if use_color() : println("# Package installed: " + pkg.id.to(String).ansi.green())
        else : println("# Package installed: " + pkg.id)
        let require = pkg.require
        if isset(require) && !require.is_any() : println("# Requires valk: " + require.str())
        p.warn_active_valk()
        return
    }

    // Install all
    p.install_packages()
    p.warn_active_valk()
}

fn cmd_package_update() {

    // Project
    let p = Project.new()

    let deps = p.config.get("dependencies").object
    if deps.length == 0 {
        println("# This project has no dependencies")
        return
    }

    // Remove the pinned version so install re-resolves the latest matching the "version" mask
    let before = Map[String]{}
    each deps.values.keys() as key {
        let dep = deps.get(key) ! {
            continue
        }
        before.set(key, dep.get("current").string)
        dep = dep.remove("current").remove("current_hash")
        deps.set(key, dep)
    }

    // Saved by the install once every version is resolved, so a failed update leaves the
    // config as it was
    p.config = p.config.set("dependencies", deps)
    p.install_packages()

    let after = p.config.get("dependencies").object
    let changed = 0
    each after.values.keys() as key {
        let dep = after.get(key) ! continue
        let now = dep.get("current").string
        let was = before.get(key) !? ""
        if now.is_empty() || now == was : continue
        println("# Updated %key: " + (was.is_empty() ? "new" : was) + " -> " + now)
        changed++
    }
    if changed == 0 : println("# Every package is at the newest version it allows")
    p.warn_active_valk()
}

fn cmd_package_remove(name: String) {

    // Project
    let p = Project.new()

    let deps = p.config.get("dependencies")
    if !deps.has(name) : error("Your project has no dependency called '%name'")

    deps.remove(name)
    fs.write(p.config_path, p.config.encode(true)) ! error("Failed to save file: " + p.config_path)
    println("# Removed '%name'")
}

fn cmd_package_versions(name: String) {
    let src = Source.new(name)
    let versions = src.get_versions()
    if versions.length == 0 : error("Package '%name' hasnt created any versions yet")

    let repo_dir = fs.add(cache_repo_dir(), src.name)
    ensure_repo(src, repo_dir)

    // Mark compatibility when inside a project with a valk version
    let valk: ?Version = null
    if fs.exists(Project.get_config_path()) : valk = Project.load().valk_version()

    if isset(valk) : println("# Versions of '%name' (project uses valk " + valk.name + ")")
    else : println("# Versions of '%name'")

    print_version_table(versions, valk, fn(v: Version) ValkRequire {
        return require_at(repo_dir, v.hash)
    })
}
