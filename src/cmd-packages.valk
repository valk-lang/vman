
use valk:ansi
use valk:fs

fn cmd_package_install(args: Array[String], options: Array[String]) {

    // Project
    let p = Project.new()

    // Source
    let install_pkg_name = args.get(0) !? null
    if isset(install_pkg_name) {
        // Version mask to install
        let install_mask = args.get(1) !? null
        let alias = args.get(2) !? null
        // Package
        let pkg = Package.init(p, install_pkg_name, install_mask)

        p.packages.set(pkg.id, pkg)

        // Install
        pkg.install()

        // Add to config
        p.add_pkg_to_config(pkg, alias)

        // Success
        if ansi:supported() : println("# Package installed: " + pkg.id.to(String).ansi.green())
        else : println("# Package installed: " + pkg.id)
        return
    }

    // Install all
    p.install_packages()
}

fn cmd_package_update() {

    // Project
    let p = Project.new()

    let deps = p.config.get("dependencies").object()
    if deps.length() == 0 {
        println("# This project has no dependencies")
        return
    }

    // Remove the pinned version so install re-resolves the latest matching the "version" mask
    each deps.values.keys() as key {
        let dep = deps.get(key) ! {
            continue
        }
        dep = dep.remove("current").remove("current_hash")
        deps = deps.set(key, dep)
    }

    p.config = p.config.set("dependencies", deps)
    fs:write(p.config_path, p.config.encode(true)) ! error("Failed to save file: " + p.config_path)

    // Run the install logic
    p.install_packages()
}

fn cmd_package_remove(args: Array[String], options: Array[String]) {

    // Project
    let p = Project.new()

    let name = args.get(0) ! help(1)

    let deps = p.config.get("dependencies")
    if !deps.has(name) {
        warn("Your project has no dependency called '%name'")
        return
    }

    deps.remove(name)
    fs:write(p.config_path, p.config.encode(true)) ! error("Failed to save file: " + p.config_path)
}
