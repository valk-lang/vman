
use valk.fs

fn div() String {
    #if OS == "win"
    return "\\"
    #else
    return "/"
    #end
}

fn version_dir(version: Version) String {
    return versions_dir() + version.name + div()
}

fn versions_dir() String {
    let dir = vman_dir() + "versions"
    if !fs.is_dir(dir) : fs.create_dir(dir) ! error("Failed to create directory: " + dir)
    return dir + div()
}

fn bin_dir() String {
    let dir = vman_dir() + "bin"
    if !fs.is_dir(dir) : fs.create_dir(dir) ! error("Failed to create directory: " + dir)
    return dir + div()
}

fn vman_dir() String {
    let home = fs.home_dir() !? "~"
    let dir = home + div() + ".vman"
    if !fs.is_dir(dir) : fs.create_dir(dir) ! error("Failed to create directory: " + dir)
    return dir + div()
}

// Templates of your own, which self-update never touches: the built-in ones live in the
// binary, so an update unpacks nothing over this directory
fn templates_dir(create: bool (false)) String {
    let dir = vman_dir() + "templates"
    if create && !fs.is_dir(dir) : fs.create_dir(dir) ! error("Failed to create directory: " + dir)
    return dir + div()
}

// Each globally installed package is a small project of its own in here, so it is installed
// exactly like a package of any other project
fn global_dir(create: bool (false)) String {
    let dir = vman_dir() + "global"
    if create && !fs.is_dir(dir) : fs.create_dir(dir) ! error("Failed to create directory: " + dir)
    return dir + div()
}

// Where the programs of globally installed packages are linked. Windows has no symlinks to
// hand out, so there the shims go next to valk, which the installer already put on PATH.
fn link_dir(create: bool (false)) String {
    #if OS == "win"
    return bin_dir()
    #else
    let home = fs.home_dir() !? "~"
    let local = home + div() + ".local"
    if create && !fs.is_dir(local) : fs.create_dir(local) ! error("Failed to create directory: " + local)
    let dir = local + div() + "bin"
    if create && !fs.is_dir(dir) : fs.create_dir(dir) ! error("Failed to create directory: " + dir)
    return dir + div()
    #end
}

fn downloads_dir() String {
    let dir = vman_dir() + "downloads"
    if !fs.is_dir(dir) : fs.create_dir(dir) ! error("Failed to create directory: " + dir)
    return dir + div()
}

fn cache_repo_dir() String {
    let dir = fs.add(vman_dir(), "repos")
    if !fs.is_dir(dir) : fs.create_dir(dir) ! error("Failed to create directory: " + dir)
    return dir
}

fn versions_json_path() String {
    return fs.add(vman_dir(), "versions.json")
}
