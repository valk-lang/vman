
use valk.json
use valk.core

error SourceError (none)

// The versions in `git ls-remote --tags` output: `<hash>\trefs/tags/<name>` per tag, and for
// an annotated tag also `<hash>\trefs/tags/<name>^{}`, the commit it points at, which wins.
// Tags that are not a version are left out.
fn versions_from_ls_remote(output: String) Array[Version] {
    let commits = Map[String]{}
    let names = Array[String]{}
    each output.split("\n") as line {
        let fields = line.rtrim("\r").split("\t")
        if fields.length != 2 : continue
        let hash = fields[0]
        let ref = fields[1]
        if !ref.starts_with("refs/tags/") : continue
        let name = ref.range("refs/tags/".length, ref.length - "refs/tags/".length)
        if name.ends_with("^{}") {
            commits.set(name.range(0, name.length - 3), hash)
            continue
        }
        if commits.has(name) : continue
        commits.set(name, hash)
        names.append(name)
    }
    let versions = Array[Version]{}
    each names as name {
        let v = Version.new(name) ! continue
        v.hash = commits.get(name) ! continue
        versions.append(v)
    }
    return versions
}

enum SRC {
    github
}

class Source {
    type: SRC
    name: String
    user_name: String ("")
    repo_name: String ("")
    versions: ?Array[Version] (null)

    static fn new(name: String) SELF {
        if !name.starts_with("github.com/") : error("Unknown source: " + name + ", package names must be with 'github.com/'.")
        if !is_valid_source_name(name) : error("Invalid github package name: " + name)

        let project = name.range("github.com/".length, name.length - "github.com/".length)
        let split = project.split("/")
        let user = split.get(0) ! error("Missing user name")
        let repo = split.get(1) ! error("Missing repo name")
        return SELF {
            type: SRC.github
            name: name.replace("/", ".")
            user_name: user
            repo_name: repo
        }
    }

    + fn str() String $to {
        return this.name
    }

    fn platform() String {
        if this.type == SRC.github : return "github"
        return "unknown"
    }

    fn assoc_name() String {
        return this.platform() + "-" + this.user_name + "-" + this.repo_name
    }

    fn clone_url() String {
        return "https://github.com/%{this.user_name}/%{this.repo_name}.git"
    }

    // The tagged versions, read with `git ls-remote`: always current, and not subject to the
    // rate limit of GitHub's API
    fn get_versions() Array[Version] {
        let vv = this.versions
        if isset(vv) : return vv
        let cmd = "git ls-remote --tags " + shell_quote(this.clone_url())
        let code, output = core.exec(cmd)
        if code == 127 : error("Git is not installed")
        if code != 0 : error("Package not found, or GitHub could not be reached: github.com/%{this.user_name}/%{this.repo_name}")
        let versions = versions_from_ls_remote(output)
        versions.sort()
        this.versions = versions
        return versions
    }

    fn get_highest_version(mask: ?Mask) Version !SourceError {
        let vv = this.get_versions()
        let high : ?Version = null
        each vv as v {
            if isset(mask) && !mask.is_compat(v) : continue
            if !isset(high) {
                high = v
                continue
            }
            if v > high : high = v
        }
        if isset(high) : return high
        throw .none
    }
}

fn is_valid_source_component(value: String) bool {
    if value.is_empty() : return false
    let i : uint = 0
    while i < value.length {
        let ch = value.get(i++)
        if ch.is_alpha() || ch.is_number() || ch == '-' || ch == '_' || ch == '.' : continue
        return false
    }
    return true
}

fn is_valid_source_name(name: String) bool {
    if !name.starts_with("github.com/") : return false
    let project = name.range("github.com/".length, name.length - "github.com/".length)
    let split = project.split("/")
    if split.length != 2 : return false
    let user = split.get(0) !? ""
    let repo = split.get(1) !? ""
    return is_valid_source_component(user) && is_valid_source_component(repo)
}
