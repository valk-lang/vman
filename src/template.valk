use valk.fs
use valk.json
use valk.ansi

// Starting code that `vman template` writes into a project. Every template is a directory
// under templates/, with a template.json next to the files it writes.
class Template {
    name: String
    description: String
    // Whether this one came from the user's own templates directory
    custom: bool (false)
    // The files to write, by their path in the project
    files: Map[String] (.{})
    // What to add to valk.json, such as the name of a package
    config: json.Value (null)
    dependencies: json.Value (null)

    static fn all() Array[Template] {
        let by_name = Map[Template]{}
        each template_files() as content, path {
            let slash = path.index_of_byte('/') ! continue
            let template_name = path.range(0, slash)
            let rest = path.range(slash + 1, path.bytes - slash - 1)
            read_into(template_in(by_name, template_name), rest, content)
        }

        // A template of your own with the name of a built-in one replaces it
        each templates_in_dir(templates_dir()) as template {
            by_name.set(template.name, template)
        }

        let result = Array[Template]{}
        each by_name.keys().sorted() as name {
            let template = by_name.get(name) ! continue
            result.append(template)
        }
        return result
    }

    static fn get(name: String) ?Template {
        each Template.all() as template {
            if template.name == name : return template
        }
        return null
    }

    // The files of this template, with `{{name}}` replaced by the name of the project
    fn rendered_files(project_name: String) Map[String] {
        let result = Map[String]{}
        each this.files as content, path {
            result.set(path.replace("{{name}}", project_name), content.replace("{{name}}", project_name))
        }
        return result
    }
}

// Puts one file of a template in place: template.json is what the template says about
// itself, everything else is written into the project
fn read_into(template: Template, path: String, content: String) {
    if path == "template.json" {
        let conf = json.decode(content) ! {
            warn("Invalid template.json in template: " + template.name)
            return
        }
        template.description = conf.get("description").string
        template.config = conf.get("config")
        template.dependencies = conf.get("dependencies")
        return
    }
    template.files.set(path, content)
}

// Reads a directory of templates: every subdirectory is one, named after it
fn templates_in_dir(dir: String) Array[Template] {
    let result = Array[Template]{}
    if !fs.is_dir(dir) : return result
    each fs.files_in(dir, false, false, true, true) !? .{} as name {
        if name.starts_with(".") : continue
        let template = Template { name: name, description: "", custom: true }
        let template_dir = fs.add(dir, name)
        each fs.files_in(template_dir, true, true, false, true) !? .{} as file {
            let content = fs.read(fs.add(template_dir, file)) ! continue
            read_into(template, file.replace("\\", "/"), content)
        }
        // A directory without files is not a template
        if template.files.length == 0 : continue
        if template.description.bytes == 0 : template.description = "A template of your own"
        result.append(template)
    }
    return result
}

fn template_in(by_name: Map[Template], name: String) Template {
    let found = by_name.get(name) !? null
    if isset(found) : return found
    let created = Template { name: name, description: "" }
    by_name.set(name, created)
    return created
}

fn template_files() Map[String] {
    return #embed_dir("templates")
}

// The name a template uses for the project: the directory it is written in, without the
// `valk-` prefix a package repository usually carries
fn project_name_of(dir: String) String {
    let path = dir
    if path == "." || path == "" : path = fs.cwd() !? "project"
    let name = fs.basename(path).lower()
    name = name.ltrim("valk-")
    let cleaned = ByteBuffer.new(name.bytes)
    let i: uint = 0
    while i < name.bytes {
        let ch = name.get(i++)
        if (ch >= 'a' && ch <= 'z') || (ch >= '0' && ch <= '9') || ch == '_' : cleaned.write_byte(ch)
        else if ch == '-' || ch == ' ' || ch == '.' : cleaned.write_byte('_')
    }
    let result = cleaned.into_string()
    if result.bytes == 0 || !result.get(0).is_alpha() : return "project"
    return result
}

fn cmd_template_list() {
    let templates = Template.all()
    println("# Templates")
    each templates as template {
        let name = use_color() ? template.name.ansi.cyan() : template.name
        let mark = template.custom ? " *" : ""
        println("  " + name + pad_to(template.name, 14) + template.description + mark)
    }
    println("")
    println("Write one into this project with: vman template {name} [directory]")
    println("Templates of your own (*) go in " + templates_dir(true) + ", one directory each")
}

fn pad_to(name: String, width: uint) String {
    if name.bytes >= width : return "  "
    let spaces = ByteBuffer.new(width)
    let i = name.bytes
    while i++ < width : spaces.write(" ")
    return spaces.into_string()
}

// Writes a built-in template into the user's templates directory, where it can be edited
// and where it then replaces the built-in one
fn cmd_template_export(name: String, force: bool) {
    let template = Template.get(name) ?! {
        println("# Unknown template: " + name)
        cmd_template_list()
        exit(1)
    }
    if template.custom : error("Template '" + name + "' is already one of your own: " + templates_dir() + name)

    let target = templates_dir(true) + name
    if fs.is_dir(target) && !force : error("Directory exists: " + target + ". Use --force to write over it")

    each template.files as content, path {
        let full = fs.add(target, path)
        create_parent_dirs(full)
        fs.write(full, content) ! error("Failed to write: " + full)
        println("# Wrote: " + full)
    }
    // What the template says about itself travels with it
    let conf: json.Value = json.new_object()
    conf = conf.set("description", json.new_string(template.description))
    let config = template.config
    if isset(config) && config.object.length > 0 : conf = conf.set("config", config)
    let dependencies = template.dependencies
    if isset(dependencies) && dependencies.object.length > 0 : conf = conf.set("dependencies", dependencies)
    let conf_path = fs.add(target, "template.json")
    fs.write(conf_path, conf.encode(true)) ! error("Failed to write: " + conf_path)
    println("# Wrote: " + conf_path)

    println("")
    println("# Edit it there; `vman template " + name + "` now writes your copy")
}

fn cmd_template_write(name: String, dir: ?String, force: bool) {
    let template = Template.get(name) ?! {
        println("# Unknown template: " + name)
        cmd_template_list()
        exit(1)
    }

    let target = target_dir_for(template, dir, force)
    let project_name = project_name_of(target)
    let files = template.rendered_files(project_name)

    // A template starts a project, so it goes into a directory with nothing in it
    prepare_target_dir(target, force)

    each files as content, path {
        let full = join_path(target, path)
        create_parent_dirs(full)
        fs.write(full, content) ! error("Failed to write: " + full)
        println("# Wrote: " + full)
    }

    // The directory the files went into is the project: its valk.json is the one that gets
    // the config and the packages, not the one of the directory vman was started in
    let started_in = fs.cwd() !? "."
    if target != "." : fs.chdir(target) ! error("Failed to enter directory: " + target)

    // The project needs a valk.json before a dependency can be added to it
    Project.init_config()

    let config = template.config
    if isset(config) && config.object.length > 0 : merge_into_config(config, project_name)

    let dependencies = template.dependencies
    if isset(dependencies) {
        each dependencies.object.values.keys() as alias {
            let dep = dependencies.get(alias)
            let src = dep.get("src").string
            if src.bytes == 0 : continue
            let mask: ?String = null
            if dep.has("version") : mask = dep.get("version").string
            cmd_package_install(src, mask, alias)
        }
    }

    if target != "." : fs.chdir(started_in) ! error("Failed to return to directory: " + started_in)

    println("")
    if use_color() : println("# Template written: " + name.ansi.green())
    else : println("# Template written: " + name)
}

// Adds what the template declares to valk.json, without touching what is already set
fn merge_into_config(config: json.Value, project_name: String) {
    let path = Project.get_config_path()
    let data = fs.read(path) ! error("Failed to read: " + path)
    let current = json.decode(data) ! error("Invalid json syntax in '" + path + "'")
    let changed = false
    each config.object.values.keys() as key {
        if current.has(key) : continue
        let value = config.get(key)
        if value.kind == json.Kind.string : value = json.new_string(value.string.replace("{{name}}", project_name))
        current = current.set(key, value)
        changed = true
    }
    if !changed : return
    fs.write(path, current.encode(true)) ! error("Failed to save file: " + path)
}

// Where the files go: the directory that was asked for, or this one when there is nothing
// in it. A template is not written on top of an existing project, so when this directory
// holds work already, the template gets one of its own next to it.
fn target_dir_for(template: Template, dir: ?String, force: bool) String {
    if isset(dir) : return dir == "" ? "." : dir.rtrim("/")
    if force : return "."
    if entries_in_the_way(".").length == 0 : return "."
    println("# This directory is not empty, writing into ./" + template.name)
    return template.name
}

// Makes sure `target` is a directory a template can be written into: it is created when it
// is not there, and otherwise has to be empty. What vman and git put there themselves does
// not count as work: valk.json, vendor, and anything hidden.
fn prepare_target_dir(target: String, force: bool) {
    if !fs.is_dir(target) {
        if fs.exists(target) : error("Not a directory: " + target)
        create_dirs(target)
        println("# Created directory: " + target)
        return
    }
    if force : return

    if entries_in_the_way(target).length == 0 : return
    error("A template needs an empty directory, and '" + target + "' is not empty. Use --force to write here anyway")
}

// What is in `dir` that makes it too busy for a template. `valk.json` and `vendor` are
// vman's own work, and a hidden entry is a repository's or an editor's, not the project's.
fn entries_in_the_way(dir: String) Array[String] {
    let result = Array[String]{}
    each fs.files_in(dir, false, true, true, true) !? .{} as name {
        if name.starts_with(".") : continue
        if name == "valk.json" || name == "vendor" : continue
        result.append(name)
    }
    return result.sorted()
}

fn create_parent_dirs(path: String) {
    create_path(path, true)
}

fn create_dirs(dir: String) {
    create_path(dir, false)
}

fn create_path(path: String, parents_only: bool) {
    let normalized = path.replace("\\", "/")
    let parts = normalized.split("/")
    // An absolute path keeps its leading separator, so the walk starts at the root
    let walked = normalized.starts_with("/") ? "/" : ""
    each parts as part, i {
        if parents_only && i == parts.length - 1 : break
        if part.bytes == 0 : continue
        if walked.bytes == 0 : walked = part
        else if walked == "/" : walked = "/" + part
        else : walked = walked + "/" + part
        if part == "." || part == ".." : continue
        if fs.is_dir(walked) : continue
        fs.create_dir(walked) ! error("Failed to create directory: " + walked)
    }
}

fn join_path(dir: String, path: String) String {
    if dir == "." || dir == "" : return path
    return dir + "/" + path
}

fn template_names() Array[String] {
    let names = Array[String]{}
    each Template.all() as template : names.append(template.name)
    return names
}
