// How deep dependencies of dependencies may nest before the configs look like a cycle
value MAX_DEPENDENCY_DEPTH (10)


use valk.fs
use valk.json

class Project {
    dir: String
    vendor_dir: String
    config_path: String
    config: json.Value
    packages: Map[Package] (.{})
    // The valk version of the project that pulled this one in. A package inside `vendor` is
    // built by the compiler of the project that uses it, so its own dependencies are chosen for
    // that version rather than the one the package was written against.
    inherited_valk: ?Version (null)

    static fn new() SELF {
        let p = SELF.load()
        if !fs.is_dir(p.vendor_dir) : fs.create_dir(p.vendor_dir) ! error("Failed to create directory: " + p.vendor_dir)
        return p
    }

    // Reads the project config without touching the vendor directory
    static fn load() SELF {
        let dir = (fs.cwd() ! error("Failed to get current directory"))
        let vendor_dir = fs.add(dir, "vendor")
        let config_path = SELF.get_config_path()
        if !fs.exists(config_path) : error("No 'valk.json' config not found: " + config_path)

        let str = fs.read(config_path) !? "{}"
        let data = json.decode(str) ! error("Invalid json syntax in '%config_path'")

        return SELF {
            dir: dir
            vendor_dir: vendor_dir
            config_path: config_path
            config: data
        }
    }

    // The valk version the project builds with: "use" in valk.json, or else the one in use
    fn valk_version() ?Version {
        let inherited = this.inherited_valk
        if isset(inherited) : return inherited
        let value = this.config.get("use").string
        if value.is_empty() : return current_used_version()
        return Version.new(value) ! error("Invalid 'use' version in valk.json: " + value)
    }

    // Stops at dependencies whose valk requirement does not include `valk`; with
    // --ignore-min, or `warn_only`, they are only warned about
    fn check_dep_requirements(valk: Version, warn_only: bool (false)) {
        let problems = Array[String]{}
        let deps = this.config.get("dependencies").object
        each deps.values as dep, key {
            let src = dep.get("src").string
            if src.is_empty() : continue
            let dir = src
            if !fs.is_dir(src) {
                let current = dep.get("current").string
                if current.is_empty() : continue
                dir = fs.add(fs.add(this.vendor_dir, Source.new(src).assoc_name()), current)
            }
            let str = fs.read(fs.add(dir, "valk.json")) ! continue
            let conf = json.decode(str) ! continue
            let req = ValkRequire.from_config(conf)
            if !req.is_compat(valk) : problems.append("Dependency '" + key + "' requires valk " + req.str() + ", the project uses " + valk.name)
        }
        if problems.length == 0 : return
        if ignore_min || warn_only {
            each problems as problem : warn(problem)
            return
        }
        each problems.range(0, problems.length - 1) as problem : warn(problem)
        error(problems[problems.length - 1] + "; " + IGNORE_MIN_HINT)
    }

    // A project rooted at an installed package, so that the package's own dependencies can be
    // installed into its vendor directory
    static fn for_package(root: Project, dir: String) ?SELF {
        let config_path = fs.add(dir, "valk.json")
        if !fs.exists(config_path) : return null

        let str = fs.read(config_path) ! error("Failed to read: " + config_path)
        let data = json.decode(str) ! error("Invalid json syntax in '%config_path'")
        if data.get("dependencies").object.length == 0 : return null

        let vendor_dir = fs.add(dir, "vendor")
        if !fs.is_dir(vendor_dir) : fs.create_dir(vendor_dir) ! error("Failed to create directory: " + vendor_dir)

        return SELF {
            dir: dir
            vendor_dir: vendor_dir
            config_path: config_path
            config: data
            inherited_valk: root.valk_version()
        }
    }

    static fn get_config_path() String {
        let dir = (fs.cwd() ! error("Failed to get current directory"))
        if !fs.is_dir(dir) : fs.create_dir(dir) ! error("Failed to create directory: " + dir)
        return fs.add(dir, "valk.json")
    }

    static fn init_config() {
        let path = SELF.get_config_path()
        let exists = fs.exists(path)
        let config: json.Value = json.new_object()

        if exists {
            let data = fs.read(path) ! error("Failed to read: " + path)
            config = json.decode(data) ! error("Invalid json syntax in '" + path + "'")
            if config.has("use") {
                println("# Project already has a 'valk.json' config")
                return
            }
        }

        let version = current_used_version()
        if isset(version) : config = config.set("use", json.new_string(version.name))
        else if exists {
            println("# Project already has a 'valk.json' config")
            return
        }

        fs.write(path, config.encode(true)) ! error("Failed to create: " + path)
    }

    fn add_pkg_to_config(pkg: Package, name: ?String) {

        if !isset(name) {
            let n = pkg.src.repo_name
            let pkg_conf = pkg.config()
            if pkg_conf.has("name") && is_valid_pkg_name(pkg_conf.get("name").string) {
                n = pkg_conf.get("name").string
            }
            if !is_valid_pkg_name(n) : error("Please provide a package alias because the default is not a valid package name: " + n)
            name = n
        }

        let deps = this.config.get("dependencies")
        let exists = deps.has(name)
        let dep = deps.get(name)
        if exists {
            if dep.get("src").string != pkg.name : error("Failed to add package to config. Name already used: " + name)
        }

        dep = dep.remove("installed").remove("installed_hash").remove("update")
        dep = dep.set("src", json.new_string(pkg.name))
        dep = dep.set("current", json.new_string(pkg.ver.name))
        dep = dep.set("current_hash", json.new_string(pkg.ver.hash))

        let mask = pkg.mask
        if isset(mask) {
            dep = dep.set("version", json.new_string(mask.name))
        } else {
            dep = dep.set("version", json.new_string("x.x.x"))
        }

        deps = deps.set(name, dep)
        this.config = this.config.set("dependencies", deps)

        fs.write(this.config_path, this.config.encode(true)) ! error("Failed to save file: " + this.config_path)
    }

    fn install_packages(depth: uint (0), announce: bool (true)) {
        let deps = this.config.get("dependencies").object

        if deps.length == 0 {
            if announce : println("# This project has no dependencies")
            return
        }
        // A package may depend on a package that depends on another; the nesting is bounded so
        // that a cycle in the configs cannot run forever
        if depth > MAX_DEPENDENCY_DEPTH : error("Dependencies nest deeper than %{MAX_DEPENDENCY_DEPTH} levels, which looks like a cycle: " + this.config_path)

        each deps.values.keys() as key {
            let dep = deps.get(key) ! {
                continue
            }

            let name = dep.get("src").string
            if name.is_empty() : error("Valk.json invalid dependency 'src'")

            // Local directory dependencies are always present
            if fs.is_dir(name) : continue

            let installed: ?Version = null
            let current = dep.get("current").string
            let hash = dep.get("current_hash").string
            if !current.is_empty() && !hash.is_empty() {
                installed = Version.new(current) ! error("Valk.json invalid version: " + current)
            }

            let pkg = resolve_dep_pkg(this, name, installed, hash, dep.get("version").string)

            // Set/update the resolved version & hash in the config
            dep = dep.set("current", json.new_string(pkg.ver.name))
            dep = dep.set("current_hash", json.new_string(pkg.ver.hash))
            // Every registry dependency has a mask; missing masks default to all versions
            let ver_mask = dep.get("version").string
            if ver_mask.is_empty() {
                let m = pkg.mask
                if isset(m) {
                    dep = dep.set("version", json.new_string(m.name))
                } else {
                    dep = dep.set("version", json.new_string("x.x.x"))
                }
            }
            deps.set(key, dep)

            // Install if the package-dir is missing
            if !pkg.installed() {
                println("> Installing: %name | %{pkg.ver.name}")
                pkg.install()
            }

            this.packages.set(pkg.id, pkg)
        }

        this.config = this.config.set("dependencies", deps)
        fs.write(this.config_path, this.config.encode(true)) ! error("Failed to save file: " + this.config_path)

        // A dependency may itself depend on packages; they are installed next to it rather than
        // inside it, so that a package two dependencies share is one package to the compiler
        this.install_nested_dependencies()

        let valk = this.valk_version()
        if isset(valk) : this.check_dep_requirements(valk)

        if announce : println("# All dependencies have been installed")
    }

    // Installs the dependencies of the packages in `vendor`, into that same `vendor` directory,
    // and points every package at the copy that lands there.
    //
    // The compiler loads a directory once, whoever asks for it, so a package that two of them
    // depend on must resolve to one directory: a version already in `vendor` that fits is
    // reused, and only a requirement nothing satisfies installs another version.
    fn install_nested_dependencies() {
        let round: uint = 0
        while round++ < MAX_DEPENDENCY_DEPTH {
            if !this.hoist_round() : return
        }
        error("Dependencies nest deeper than %{MAX_DEPENDENCY_DEPTH} levels, which looks like a cycle")
    }

    // One pass over every installed package. Returns whether anything changed, so that a
    // package pulled in by this pass gets a pass of its own.
    fn hoist_round() bool {
        let changed = false
        each this.installed_package_dirs() as pkg_dir {
            let config_path = fs.add(pkg_dir, "valk.json")
            let str = fs.read(config_path) ! continue
            let conf = json.decode(str) ! continue
            let deps = conf.get("dependencies").object
            if deps.length == 0 : continue

            let rewritten = false
            each deps.values.keys() as key {
                let dep = deps.get(key) ! continue
                let src = dep.get("src").string
                // Already pointed at a directory, by this pass or by the package itself
                if src.is_empty() || src.starts_with(".") : continue

                let mask = dep.get("version").string
                if mask.is_empty() : mask = "x.x.x"
                let source = Source.new(src)
                let assoc = source.assoc_name()

                let version = this.vendored_version_for(assoc, mask)
                if !isset(version) {
                    // Nothing here fits, so it is installed next to the packages that need it
                    let pkg = Package.init(this, src, mask)
                    if !pkg.installed() {
                        println("> Installing: %src | %{pkg.ver.name}")
                        pkg.install()
                    }
                    version = pkg.ver.name
                    changed = true
                }

                // `../../<package>/<version>`: the copy in this project's vendor directory
                dep = dep.remove("current").remove("current_hash")
                dep = dep.set("src", json.new_string("../../" + assoc + "/" + version))
                deps.set(key, dep)
                rewritten = true
            }

            if rewritten {
                conf = conf.set("dependencies", deps)
                fs.write(config_path, conf.encode(true)) ! error("Failed to save file: " + config_path)
            }
        }
        return changed
    }

    // The versions of every package that is installed in this project's vendor directory
    fn installed_package_dirs() Array[String] {
        let dirs = Array[String]{}
        let packages = fs.files_in(this.vendor_dir, false, false, true) !? .{}
        each packages as package_dir {
            let versions = fs.files_in(package_dir, false, false, true) !? .{}
            each versions as version_dir {
                dirs.append(version_dir)
            }
        }
        return dirs
    }

    // A version of `assoc` that is installed and fits `mask`, newest first; null when there is
    // none
    fn vendored_version_for(assoc: String, mask: String) ?String {
        let m = Mask.new(mask) ! return null
        let pkg_dir = fs.add(this.vendor_dir, assoc)
        if !fs.is_dir(pkg_dir) : return null
        let found: ?Version = null
        each (fs.files_in(pkg_dir, false, false, true) !? .{}) as version_dir {
            let name = fs.basename(version_dir)
            let version = Version.new(name) ! continue
            if !m.is_compat(version) : continue
            if !isset(found) || version > found : found = version
        }
        if !isset(found) : return null
        return found.name
    }

    fn clean_vendor() {
        let deps = this.config.get("dependencies").object

        // Directories that are used by the config and must be preserved
        let protected = Array[String]{}

        // Map vendored package dir by its assoc name, used version
        let pkg_dirs = fs.files_in(this.vendor_dir, false, false, true) ! error("Failed to read directory")

        each pkg_dirs as pkg_dir {
            let pkg_name = fs.basename(pkg_dir)

            // Collect every version current in the config that maps to this package
                let used = Array[Version]{}
            each deps.values.keys() as key {
                let dep = deps.get(key) ! {
                    continue
                }
                let src = dep.get("src").string
                if src.is_empty() : continue
                // Local directory dependencies have no vendored package dir
                if fs.is_dir(src) : continue
                if Source.new(src).assoc_name() == pkg_name {
                    let current = dep.get("current").string
                    if !current.is_empty() {
                        used.append(Version.new(current) ! error("Valk.json invalid version: " + current))
                    }
                }
            }

            // No dependency uses this package -> delete the whole directory
            if used.length == 0 {
                fs.delete_all(pkg_dir) ! error("Failed to delete: " + pkg_dir)
                continue
            }

            // Delete version sub-directories that aren't a used version
            let versions = fs.files_in(pkg_dir, false, false, true) ! error("Failed to read directory")
            each versions as ver_dir {
                let version = Version.new(fs.basename(ver_dir)) ! {
                    fs.delete_all(ver_dir) ! error("Failed to delete: " + ver_dir)
                    continue
                }
                if used.contains(version) {
                    protected.append(ver_dir)
                } else {
                    fs.delete_all(ver_dir) ! error("Failed to delete: " + ver_dir)
                }
            }
        }

        // Delete every empty folder under ./vendor that isn't used by the config
        remove_empty_dirs(this.vendor_dir, protected)
    }
}

fn remove_empty_dirs(dir: String, protected: Array[String]) {
    let subdirs = fs.files_in(dir, false, false, true) ! error("Failed to read directory")
    each subdirs as sub {
        if protected.contains(sub) : continue
        remove_empty_dirs(sub, protected)
        if fs.is_dir(sub) && (fs.files_in(sub) !? Array[String]{}).length == 0 {
            fs.delete_dir(sub) _
        }
    }
}

fn resolve_dep_pkg(project: Project, name: String, installed: ?Version, hash: String, mask: String) Package {
    if isset(installed) && !hash.is_empty() {
        return Package.from_config(project, name, installed, hash)
    }
    let requested : ?String = null
    if !mask.is_empty() : requested = mask
    return Package.init(project, name, requested)
}

fn is_valid_pkg_name(n: String) bool {
    if n.is_empty() : return false
    let i : uint = 0
    let len = n.length
    while i < len {
        let ch = n.get(i++)
        if ch.is_alpha() || ch == '_' || (i > 1 && ch.is_number()) : continue
        return false
    }
    return true
}
