
use valk:json
use valk:fs
use valk:time
use valk:ansi

class Versions {
    vman_latest: String
    vman_current: String
    valk: json:Value
}

class ReleaseVersions {
    vman_latest: String
    valk: json:Value
}

fn release_channel(data: json:Value, name: String, channel: String) ?String {
    let version = data.get(name).get(channel).string()
    if version.is_empty() : return null
    return version
}

fn optional_string(value: ?String) String {
    if isset(value) : return value
    return ""
}

fn release_channel_or_default(data: json:Value, name: String, channel: String) String {
    let version = release_channel(data, name, channel)
    if isset(version) : return version
    return optional_string(release_channel(data, name, "default"))
}

fn parse_release_versions(data: json:Value) ReleaseVersions {
    let valk = data.get("valk")
    return ReleaseVersions {
        vman_latest: release_channel_or_default(data, "vman", "latest")
        valk: valk
    }
}

fn get_versions() Versions {
    let cd = vman_dir()
    let path = cd + "vman.json"
    let data = fs:read(path) !? "{}"
    let conf = json:decode(data) !? json:new_object()

    let vman_latest = conf.get("vman-latest").string()
    let valk = conf.get("valk")
    let last_update = conf.get("last-update").int().to(uint)

    if vman_latest.is_empty() : vman_latest = VERSION

    let now = time:microtime()
    let one_day : uint = 1000 * 1000 * 60 * 60 * 1 // 1 hour
    if now - last_update > one_day || !valk.has("default") {
        cdn_get_versions() -> res {
            let fetched = parse_release_versions(res)
            if !fetched.vman_latest.is_empty() && fetched.valk.has("default") {
                vman_latest = fetched.vman_latest
                valk = fetched.valk

                conf.set("vman-latest", json:new_string(fetched.vman_latest))
                conf.set("valk", fetched.valk)
                conf.set("last-update", json:new_int(now.to(int)))
                fs:write(path, conf.encode(true)) _
            }
        }
    }

    return Versions {
        vman_latest: vman_latest
        vman_current: VERSION
        valk: valk
    }
}

fn resolve_valk_version(vv: Versions, requested: String) String {
    if requested == "default" {
        let version = vv.valk.get("default").string()
        if version.is_empty() : error("vman was unable to find the default valk version")
        return version
    }
    let named = vv.valk.get(requested).string()
    if !named.is_empty() : return named
    if !is_valid_version(requested) : error("vman was unable to find the valk version channel: " + requested)
    return requested
}

fn vman_is_up_to_date(vv: Versions) bool {
    let v_current = Version.new(vv.vman_current) !? null
    let v_latest = Version.new(vv.vman_latest) !? null
    return isset(v_current) && isset(v_latest) && v_current >= v_latest
}

fn check_vman_versions(vv: Versions) {
    if vman_is_up_to_date(vv) {
        if ansi:supported() : println("# vman is " + "up-to-date".ansi.green())
        else : println("# vman is " + "up-to-date")
    } else {
        println("# There is a new vman version available: " + vv.vman_latest)
        println("# Update command: vman self-update")
    }
}

fn is_valid_version(v: String) bool {
    Version.new(v) ! return false
    return true
}
