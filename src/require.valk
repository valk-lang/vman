
use valk.json
use valk.core

error SelectError (none, incompatible)

value IGNORE_MIN_HINT ("pass --ignore-min to go ahead anyway")

// Set by --ignore-min: a package that needs a newer valk is installed with a warning
// instead of an error
global ignore_min : bool (false)

// The lowest valk compiler version a package declares in its valk.json:
// { "require": { "valk": { "min": "0.7.0" } } }
class ValkRequire {
    min: ?Version (null)

    static fn from_config(conf: json.Value) SELF {
        let req = conf.get("require").get("valk")
        let res = SELF {}
        let min = req.get("min").string
        if !min.is_empty() {
            let v = Version.new(min) !? null
            if !isset(v) : warn("Invalid 'require.valk.min' version: " + min)
            res.min = v
        }
        return res
    }

    fn is_any() bool {
        return !isset(this.min)
    }

    fn is_compat(v: Version) bool {
        let min = this.min
        if isset(min) && v < min : return false
        return true
    }

    + fn str() String $to {
        let min = this.min
        if isset(min) : return ">= " + min.name
        return "any"
    }
}

// Reads the package valk.json as it was at `hash` in the cloned repository
fn package_config_at(repo_dir: String, hash: String) ?json.Value {
    let cmd = "git -C " + shell_quote(repo_dir) + " show " + shell_quote(hash + ":valk.json")
    let code, output = core.exec(cmd)
    if code != 0 : return null
    return json.decode(output) !? null
}

fn require_at(repo_dir: String, hash: String) ValkRequire {
    let conf = package_config_at(repo_dir, hash) ?! return ValkRequire{}
    return ValkRequire.from_config(conf)
}

// Picks the highest version matching `mask` that supports `valk` (any version when `valk` is null)
fn select_version(versions: Array[Version], mask: ?Mask, valk: ?Version, require_of: fn(Version)(ValkRequire)) Version !SelectError {
    let candidates = Array[Version]{}
    each versions as v {
        if isset(mask) && !mask.is_compat(v) : continue
        candidates.append(v)
    }
    if candidates.length == 0 : throw .none

    each candidates.sorted().reversed() as v {
        if !isset(valk) : return v
        if require_of(v).is_compat(valk) : return v
    }
    throw .incompatible
}

// The newest version matching `mask` that supports `valk`. When none does, that is an error,
// or with --ignore-min a warning and the newest version matching `mask`.
fn pick_version(name: String, versions: Array[Version], mask: Mask, valk: ?Version, require_of: fn(Version)(ValkRequire)) Version {
    return select_version(versions, mask, valk, require_of) ! {
        if E.code == E.none || !isset(valk) : error("Package '%name' has no versions matching: " + mask.name)
        println("# Versions of '%name' matching '" + mask.name + "' (project uses valk " + valk.name + ")")
        print_version_table(versions.filter(fn(v: Version) bool { return mask.is_compat(v) }), valk, require_of)
        if !ignore_min : error("Package '%name' has no versions matching '" + mask.name + "' that support valk " + valk.name + "; " + IGNORE_MIN_HINT)
        let newest = select_version(versions, mask, null, require_of) ! error("Package '%name' has no versions matching: " + mask.name)
        warn("Package '%name' " + newest.name + " requires valk " + require_of(newest).str() + ", the project uses " + valk.name)
        return newest
    }
}

fn print_version_table(versions: Array[Version], valk: ?Version, require_of: fn(Version)(ValkRequire)) {
    each versions.sorted().reversed() as v {
        let req = require_of(v)
        let line = " " + v.name.pad_right(' ', 10) + " valk: " + req.str()
        if isset(valk) {
            if req.is_compat(valk) : line = line + "  " + emo("✅", "[ok]")
            else : line = line + "  " + emo("❌", "[incompatible]")
        }
        println(line)
    }
}
