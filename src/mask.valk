
error MaskError (invalid)

class Mask {
    name: String
    n1: uint (0)
    n2: uint (0)
    n3: uint (0)
    n1_any: bool
    n2_any: bool
    n3_any: bool

    static fn new(value: String) SELF !MaskError {

        let split = value.split(".")
        if split.length == 0 || split.length > 3 : throw .invalid

        let contains_x = false
        each split as part {
            if part == "x" {
                contains_x = true
                continue
            }
            if !part.is_integer() : throw .invalid
            part.to_uint() ! throw .invalid
        }
        if !contains_x && split.length != 3 : throw .invalid

        let p1 = split.get(0) !? "x"
        let p2 = split.get(1) !? "x"
        let p3 = split.get(2) !? "x"
        let n1_any = p1 == "x"
        let n2_any = p2 == "x"
        let n3_any = p3 == "x"
        let n1: uint = n1_any ? 0 : p1.to_uint() ! throw .invalid
        let n2: uint = n2_any ? 0 : p2.to_uint() ! throw .invalid
        let n3: uint = n3_any ? 0 : p3.to_uint() ! throw .invalid

        return Mask {
            name: value
            n1: n1
            n2: n2
            n3: n3
            n1_any: n1_any
            n2_any: n2_any
            n3_any: n3_any
        }
    }

    static fn is_mask(value: String) bool {
        let mask = SELF.new(value) ! return false
        return mask.n1_any || mask.n2_any || mask.n3_any
    }

    fn is_compat(v: Version) bool {
        if !this.n1_any && this.n1 != v.n1 : return false
        if !this.n2_any && this.n2 != v.n2 : return false
        if !this.n3_any && this.n3 != v.n3 : return false
        return true
    }
}
