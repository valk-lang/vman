use valk.fs

fn cmd_clean(what: String) {
    let sub = what

    if sub == "packages" {
        // If inside a project with a config, clean unused vendor packages
        let config_path = Project.get_config_path()
        if fs.exists(config_path) {
            let p = Project.new()
            p.clean_vendor()
            println("# Cleaned vendor packages")
        } else {
            println("# Not inside a project, nothing to clean")
        }
    } else if sub == "cache" {
        // Clear the http request cache
        let cache_path = Cache.path()
        if fs.exists(cache_path) : fs.delete_file(cache_path) _
        // Remove downloaded files
        let dir = downloads_dir()
        fs.delete_all(dir) ! error("Failed to delete: " + dir)
        fs.create_dir(dir) ! error("Failed to recreate downloads directory: " + dir)
        println("# Cleaned cache")
    } else if sub == "repos" {
        // Remove every cloned package repository
        let repos_dir = cache_repo_dir()
        fs.delete_all(repos_dir) ! error("Failed to delete: " + repos_dir)
        fs.create_dir(repos_dir) ! error("Failed to recreate repos directory: " + repos_dir)
        println("# Cleaned repos")
    } else {
        error("Unknown clean subcommand: '" + sub + "'. Use 'packages', 'cache' or 'repos'")
    }
}

fn cmd_unuse(requested: String) {
    let version = Version.new(requested) ! error("Invalid version syntax: '" + requested + "'")

    let current = current_used_version()

    // Remove the installed toolchain version directory if it exists
    let dir = version_dir(version)
    if fs.is_dir(dir) {
        fs.delete_all(dir) ! error("Failed to delete: " + dir)
        println("# Removed version: " + version.name)
    } else {
        println("# Version not installed: " + version.name)
    }

    // If it was the current version, or the current could not be determined,
    // remove the symlink (the target is now gone or unknown)
    if !isset(current) || current == version {
        remove_current_link()
    }
}

fn current_used_version() ?Version {
    #if OS == "win"
    let link = bin_dir() + "valk.bat"
    #else
    let link = bin_dir() + valk_exe()
    #end

    #if OS == "win"
    let content = fs.read(link) ! return null
    let target = content.split("\"").get(1) ! return null
    #else
    let target = fs.realpath(link) ! return null
    #end
    if !target.starts_with(versions_dir()) : return null

    return Version.new(fs.basename(fs.dir_of(target))) ! return null
}

fn remove_current_link() {
    #if OS == "win"
    let link = bin_dir() + "valk.bat"
    #else
    let link = bin_dir() + valk_exe()
    #end
    // unlink removes the symlink itself, even when its target is gone (dangling)
    fs.delete_file(link) ! warn("Failed to remove link: " + link)
}
