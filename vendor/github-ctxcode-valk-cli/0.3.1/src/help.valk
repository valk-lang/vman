use valk.core
use valk.ansi

/// Whether help and error text is written with colours. It follows the terminal by default: off
/// when standard output is not a terminal, such as a pipe or a file, and when `NO_COLOR` is set.
+ global colors: bool (ansi.supported() && !has_no_color() && stdout_is_terminal())

fn has_no_color() bool {
    let value = core.getenv("NO_COLOR") ! return false
    return value.length > 0
}

#if OS == "win"
extern fn _isatty(fd: i32) i32;
#else
extern fn isatty(fd: i32) i32;
#end

fn stdout_is_terminal() bool {
    #if OS == "win"
    return _isatty(1) != 0
    #else
    return isatty(1) != 0
    #end
}

fn heading(text: String) String {
    if !colors : return text
    return text.ansi.yellow(true)
}
fn accent(text: String) String {
    if !colors : return text
    return text.ansi.cyan()
}
fn faint(text: String) String {
    if !colors : return text
    return text.ansi.white()
}

/// Returns the help text of a command: what it does, how it is used, and every command, option
/// and argument it has.
+ fn help_text(command: Command, version: String ("")) String {
    let out = ByteBuffer.new(512)

    if command.summary.length > 0 {
        out.write(command.summary)
        out.write("\n\n")
    }
    out.write(heading("Usage:"))
    out.write("\n  ")
    out.write(command.usage())
    out.write("\n")

    if command.description.length > 0 {
        out.write("\n")
        out.write(command.description)
        out.write("\n")
    }

    if command.commands.length > 0 {
        out.write("\n")
        out.write(heading("Commands:"))
        out.write("\n")
        let width = widest_command(command)
        each command.commands as sub {
            out.write("  ")
            out.write(accent(pad(sub.name, width)))
            if sub.summary.length > 0 {
                out.write("  ")
                out.write(sub.summary)
            }
            out.write("\n")
        }
    }

    if command.arguments.length > 0 {
        out.write("\n")
        out.write(heading("Arguments:"))
        out.write("\n")
        let width = widest_argument(command)
        each command.arguments as argument {
            out.write("  ")
            out.write(accent(pad(argument_label(argument), width)))
            if argument.help.length > 0 {
                out.write("  ")
                out.write(argument.help)
            }
            out.write("\n")
        }
    }

    let labels = option_labels(command, command.flags, command.options, true)
    let global_labels = option_labels(command, command.inherited_flags(), command.inherited_options(), false)
    let width: uint = 0
    each labels as label {
        if label.text.utf8.length > width : width = label.text.utf8.length
    }
    each global_labels as label {
        if label.text.utf8.length > width : width = label.text.utf8.length
    }
    write_labels(out, "Options:", labels, width)
    write_labels(out, "Global options:", global_labels, width)

    if version.length > 0 && !isset(command.parent) {
        out.write("\n")
        out.write(faint("Version " + version))
        out.write("\n")
    }
    return out.to_string()
}

class HelpLabel {
    text: String
    help: String ("")
    extra: String ("")
}

fn argument_label(argument: Argument) String {
    let name = argument.name
    if argument.variadic : name += "..."
    return argument.required ? "<" + name + ">" : "[" + name + "]"
}

fn write_labels(out: ByteBuffer, title: String, labels: Array[HelpLabel], width: uint) {
    if labels.length == 0 : return
    out.write("\n")
    out.write(heading(title))
    out.write("\n")
    each labels as label {
        out.write("  ")
        out.write(accent(pad(label.text, width)))
        if label.help.length > 0 {
            out.write("  ")
            out.write(label.help)
        }
        if label.extra.length > 0 {
            out.write(" ")
            out.write(faint(label.extra))
        }
        out.write("\n")
    }
}

// `-o, --output <file>` for every option and switch, with `--help` and `--version` at the end
// of the command's own list
fn option_labels(command: Command, flags: Array[Flag], options: Array[Option], own: bool) Array[HelpLabel] {
    let labels = Array[HelpLabel]{}
    each flags as flag {
        let text = flag.short.length > 0 ? "-" + flag.short + ", --" + flag.long : "    --" + flag.long
        let extra = flag.env.length > 0 ? "[" + flag.env + "]" : ""
        labels.append(HelpLabel { text: text, help: flag.help, extra: extra })
    }
    each options as option {
        let text = option.short.length > 0 ? "-" + option.short + ", --" + option.long : "    --" + option.long
        text += " <" + option.placeholder + ">"
        let extra = ""
        if option.choices.length > 0 : extra += "[" + option.choices.join("|") + "] "
        if option.default.length > 0 : extra += "[default: " + option.default + "] "
        if option.env.length > 0 : extra += "[" + option.env + "] "
        if option.required : extra += "[required] "
        labels.append(HelpLabel { text: text, help: option.help, extra: extra.rtrim(" ") })
    }
    if !own : return labels
    let help = isset(command.find_short_flag("h")) || isset(command.find_short_option("h")) ? "    --help" : "-h, --help"
    labels.append(HelpLabel { text: help, help: "Show this help" })
    if !isset(command.parent) : labels.append(HelpLabel { text: "    --version", help: "Show the version" })
    return labels
}

// Pads to a width in characters, so names that are not ASCII line up too
fn pad(text: String, width: uint) String {
    return text.pad_right(' ', width + text.length - text.utf8.length)
}

fn widest_command(command: Command) uint {
    let width: uint = 0
    each command.commands as sub {
        if sub.name.utf8.length > width : width = sub.name.utf8.length
    }
    return width
}

fn widest_argument(command: Command) uint {
    let width: uint = 0
    each command.arguments as argument {
        let length = argument_label(argument).utf8.length
        if length > width : width = length
    }
    return width
}
